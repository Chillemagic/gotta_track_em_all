<% if exists %>
  <div class="bg-white border border-red-300 text-red-700 text-sm rounded shadow-md px-3 py-2 transition-opacity duration-200 ease-out opacity-100">
    Username is taken
  </div>
<% else %>
  <div class="bg-white border border-green-300 text-green-700 text-sm rounded shadow-md px-3 py-2 transition-opacity duration-200 ease-out opacity-100">
    Username is available
  </div>
<% end %>
