<main class="isolate">
  <!-- Hero section -->
  <div class="relative pt-10">
    <!-- Background-->
    <div aria-hidden="true" class="absolute inset-x-0 -top-40 -z-10 transform-gpu overflow-hidden blur-3xl sm:-top-80">
      <div style="clip-path: polygon(74.1% 44.1%, 100% 61.6%, 97.5% 26.9%, 85.5% 0.1%, 80.7% 2%, 72.5% 32.5%, 60.2% 62.4%, 52.4% 68.1%, 47.5% 58.3%, 45.2% 34.5%, 27.5% 76.7%, 0.1% 64.9%, 17.9% 100%, 27.6% 76.8%, 76.1% 97.7%, 74.1% 44.1%)"
        class="relative left-[calc(50%-11rem)] aspect-1155/678 w-144.5 -translate-x-1/2 rotate-30 bg-gradient-to-tr from-[#ff80b5] to-[#9089fc] opacity-30 sm:left-[calc(50%-30rem)] sm:w-288.75">
      </div>
    </div>

    <!-- Login Card -->
    <div class="py-1 sm:py-8 lg:pb-24">
      <div class="mx-auto max-w-7xl px-6 lg:px-8">
        <div class="mx-auto max-w-md bg-white/30 backdrop-blur rounded-2xl p-8 ring-1 ring-white/5 shadow-2xl">
          <h1>Create a new collection</h1>

          <%= simple_form_for(@collection) do |c| %>
            <%= c.input :name %>
            <%= c.input :description %>
            <%= render "components/button", button_label: "Create Collection", width: "w-full" %>
              <%# For form submit: render "components/button", button_label: "Create Collection", width: "w-full" %>
          <% end %>
          <div class="flex justify-between mt-4">
            <%= render "components/button", button_label: "Home Page", width: "w-2/5", button_path: users_home_path %>
            <%= render "components/button", button_label: "Collections", width: "w-2/5", button_path: collections_path %>
          </div>
        </div>
      </div>
    </div>
  </div>
</main>
