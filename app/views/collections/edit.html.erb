<!-- app/views/collections/edit.html.erb -->
<h1>Edit Collection</h1>

<%= form_with model: @collection do |f| %>
  <p>
    <%= f.label :name %><br>
    <%= f.text_field :name %>
  </p>

  <p>
    <%= f.label :description %><br>
    <%= f.text_area :description %>
  </p>

  <%= f.submit "Save changes" %>
<% end %>
