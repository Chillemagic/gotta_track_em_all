
  <!-- Nav bar -->
  <div class="mx-auto mt-6 max-w-4xl px-4">
  <h1 class="text-5xl font-pokemon text-yellow-400 drop-shadow-[2px_2px_0px_#3B4CCA]">

    <%= @collection.name %>
  </h1>

  <p class="mt-5 text-lg mb-8 font-saira text-gray-200 leading-relaxed">
    <%= @collection.description %>
  </p>

  <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
    <% @collection.collection_cards.each do |collection_card| %>
      <% card = collection_card.card %>
      <div class="bg-white/10 backdrop-blur rounded-lg p-6 ring-1 ring-white/5 space-y-6">
          <div class="pkm-holo rounded-md w-full" style="--front: url('<%= card.image_url %>')" role="img" aria-label="<%= card.name %>"></div>
          <%# Card name etc%>
          <div class="mt-4">
            <p class="text-2xl"><%= card.name %></p>
            <p class="flex items-center gap-2">
              <span class="card card--icon" aria-hidden="true">
                <span class="card-info"></span>
              </span>
              <span class="underline font-semibold">Pokemon Set:</span>
              <span><%= card.set_name %></span>
            </p>

            <p class="flex items-center gap-2">
              <!-- calendar icon -->
              <svg class="inline-block w-5 h-5 shrink-0" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" xmlns="http://www.w3.org/2000/svg">
                <path d="M8 9C7.44772 9 7 9.44771 7 10C7 10.5523 7.44772 11 8 11H16C16.5523 11 17 10.5523 17 10C17 9.44771 16.5523 9 16 9H8Z" />
                <path fill-rule="evenodd" clip-rule="evenodd" d="M6 3C4.34315 3 3 4.34315 3 6V18C3 19.6569 4.34315 21 6 21H18C19.6569 21 21 19.6569 21 18V6C21 4.34315 19.6569 3 18 3H6ZM5 18V7H19V18C19 18.5523 18.5523 19 18 19H6C5.44772 19 5 18.5523 5 18Z" />
              </svg>

              <span class="underline font-semibold">Release Date:</span>
              <span><%= card.release_date %></span>
            </p>
            <p class="flex items-center gap-2">
              <!-- rarity/diamond icon -->
              <svg class="inline-block w-5 h-5 shrink-0" viewBox="0 0 512 512" fill="currentColor" aria-hidden="true" xmlns="http://www.w3.org/2000/svg">
                <path d="M168.5 72l87.5 93 87.5-93-175 0zM383.9 99.1l-72.3 76.9 129 0-56.6-76.9zm50 124.9L78.1 224 256 420.3 433.9 224zM71.5 176l129 0-72.3-76.9-56.6 76.9zm434.3 40.1l-232 256c-4.5 5-11 7.9-17.8 7.9s-13.2-2.9-17.8-7.9l-232-256c-7.7-8.5-8.3-21.2-1.5-30.4l112-152c4.5-6.1 11.7-9.8 19.3-9.8l240 0c7.6 0 14.8 3.6 19.3 9.8l112 152c6.8 9.2 6.1 21.9-1.5 30.4z"/>
              </svg>

              <span class="underline font-semibold">Card Rarity:</span>
              <span><%= card.rarity %></span>
            </p>

            <div class="flex justify-between mt-4 gap-2">
              <%= render  "components/button",
                          button_label: "Card info",
                          button_path: collection_card_path(collection_card) %>

                <%= link_to collection_card_path(collection_card),
                      data: { turbo_method: :delete, turbo_confirm: "Remove this card?" },
                      class: "inline-flex items-center gap-1.5 rounded-full bg-white/30 px-2.5 py-1 text-sm font-semibold text-white ring-1 ring-inset ring-white/5 hover:bg-white/20" do %>
                  <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="size-4">
                    <path stroke-linecap="round" stroke-linejoin="round" d="m14.74 9-.346 9m-4.788 0L9.26 9m9.968-3.21c.342.052.682.107 1.022.166m-1.022-.165L18.16 19.673a2.25 2.25 0 0 1-2.244 2.077H8.084a2.25 2.25 0 0 1-2.244-2.077L4.772 5.79m14.456 0a48.108 48.108 0 0 0-3.478-.397m-12 .562c.34-.059.68-.114 1.022-.165m0 0a48.11 48.11 0 0 1 3.478-.397m7.5 0v-.916c0-1.18-.91-2.164-2.09-2.201a51.964 51.964 0 0 0-3.32 0c-1.18.037-2.09 1.022-2.09 2.201v.916m7.5 0a48.667 48.667 0 0 0-7.5 0" />
                  </svg>
                <% end %>
            </div>
          </div>
      </div>
    <% end %>
  </div>
</div>
