<div class="mx-auto max-w-5xl px-2 py-8">
  <div class="w-full flex">
    <div class="mx-auto">
      <h1 class="font-pokemon text-2xl justify-self-center min-[599px]:mb-2 mb-4 sm:text-3xl sm:justify-self-center  md:text-4xl md:justify-self-center lg:5xl text-yellow-400 drop-shadow-[2px_2px_0px_#3B4CCA]">
        Your Collections
      </h1>
    </div> 
  </div>
  <!-- __________________________________WIP: Scroll Area ________________________________-->
  <div data-controller="scroll-area" data-scroll-area-target="root" data-action="mouseenter->scroll-area#onRootMouseEnter mouseleave->scroll-area#onRootMouseLeave" class="relative w-full pb-5">
    <div class="flex justify-between items-center my-3">
      <div class="flex items-center px-4 py-2">
        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="size-6 mx-auto">
          <path stroke-linecap="round" stroke-linejoin="round" d="M7.5 21 3 16.5m0 0L7.5 12M3 16.5h13.5m0-13.5L21 7.5m0 0L16.5 12M21 7.5H7.5" />
        </svg>
        <h2 class="p-2 text-sm">
          Swipe to view 
        </h2>  
      </div>
      <%= link_to new_collection_path, class: "block px-4 py-2 text-sm text-left text-white-700 focus:bg-gray-100 focus:outline-hidden hover:text-yellow-400 hover:text-l hover:ease-in-out" do %>
        <div class="flex items-center">
          <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="size-6">
            <path stroke-linecap="round" stroke-linejoin="round" d="M12 4.5v15m7.5-7.5h-15" />
          </svg>
          <h2 class="mx-2">
            New 
          </h2>               
        </div>
      <% end %>
    </div>
    <!-- Viewport -->
    <div class="rounded-xl border border-black/10 dark:border-white/10 bg-neutral-50 dark:bg-neutral-900 p-2">
      <div class="py-4 overflow-x-auto scrollbar-hide flex gap-4 scroll-fade-x" data-scroll-area-target="viewport" data-action="scroll->scroll-area#onViewportScroll">
        <% count = @collections.count %>
        <% @collections.each.with_index do |c, index| %>
          <% position = index + 1 %>
          <article class="group relative w-80 shrink-0 snap-start rounded-2xl bg-white/10 backdrop-blur ring-1 ring-white/5 p-5 transition hover:bg-white/[0.15] hover:ring-white/10">

            <div class="w-full flex">
              <h2 class="mx-auto">Collection #<%= position %>/<%= count %> </h2>  
            </div>

            <div class="flex items-start gap-3">
              <h2 class="text-xl font-semibold text-white leading-snug"><%= c.name %></h2>
              <div class="ml-auto">
                <el-dropdown class="inline-block">
                  <button
                    type="button"
                    class="inline-flex items-center justify-center p-2 text-gray-400 hover:text-white focus-visible:outline-none"
                    aria-label="Options"
                  >
                    <svg viewBox="0 0 20 20" fill="currentColor" aria-hidden="true" class="size-5">
                      <circle cx="10" cy="4" r="1.5" />
                      <circle cx="10" cy="10" r="1.5" />
                      <circle cx="10" cy="16" r="1.5" />
                    </svg>
                  </button>

                  <el-menu anchor="bottom end" popover class="w-56 origin-top-right divide-y divide-white/10 rounded-md bg-gray-800 outline-1 -outline-offset-1 outline-white/10 transition transition-discrete [--anchor-gap:--spacing(2)] data-closed:scale-95 data-closed:transform data-closed:opacity-0 data-enter:duration-100 data-enter:ease-out data-leave:duration-75 data-leave:ease-in">
                    <div class="py-1">
                      <%= link_to edit_collection_path(c),
                                  class: "group/item flex items-center px-4 py-2 text-sm text-gray-300 focus:bg-white/5 focus:text-white focus:outline-hidden",
                                  role: "button" do %>
                      <svg viewBox="0 0 20 20" fill="currentColor" aria-hidden="true" class="mr-3 size-5 text-gray-500 group-focus/item:text-white">
                        <path d="m5.433 13.917 1.262-3.155A4 4 0 0 1 7.58 9.42l6.92-6.918a2.121 2.121 0 0 1 3 3l-6.92 6.918c-.383.383-.84.685-1.343.886l-3.154 1.262a.5.5 0 0 1-.65-.65Z" />
                        <path d="M3.5 5.75c0-.69.56-1.25 1.25-1.25H10A.75.75 0 0 0 10 3H4.75A2.75 2.75 0 0 0 2 5.75v9.5A2.75 2.75 0 0 0 4.75 18h9.5A2.75 2.75 0 0 0 17 15.25V10a.75.75 0 0 0-1.5 0v5.25c0 .69-.56 1.25-1.25 1.25h-9.5c-.69 0-1.25-.56-1.25-1.25v-9.5Z" />
                      </svg>
                      Edit
                      <% end %>
                    </div>


                    <div class="py-1">
                      <%= link_to collection_path(c), data: { turbo_method: :delete, turbo_confirm: "Delete this collection?" },
                                  class: "group/item flex items-center px-4 py-2 text-sm text-gray-300 focus:bg-white/5 focus:text-white focus:outline-hidden",
                                  role: "button" do %>
                      <svg viewBox="0 0 20 20" fill="currentColor" data-slot="icon" aria-hidden="true" class="mr-3 size-5 text-gray-500 group-focus/item:text-white">
                        <path d="M8.75 1A2.75 2.75 0 0 0 6 3.75v.443c-.795.077-1.584.176-2.365.298a.75.75 0 1 0 .23 1.482l.149-.022.841 10.518A2.75 2.75 0 0 0 7.596 19h4.807a2.75 2.75 0 0 0 2.742-2.53l.841-10.52.149.023a.75.75 0 0 0 .23-1.482A41.03 41.03 0 0 0 14 4.193V3.75A2.75 2.75 0 0 0 11.25 1h-2.5ZM10 4c.84 0 1.673.025 2.5.075V3.75c0-.69-.56-1.25-1.25-1.25h-2.5c-.69 0-1.25.56-1.25 1.25v.325C8.327 4.025 9.16 4 10 4ZM8.58 7.72a.75.75 0 0 0-1.5.06l.3 7.5a.75.75 0 1 0 1.5-.06l-.3-7.5Zm4.34.06a.75.75 0 1 0-1.5-.06l-.3 7.5a.75.75 0 1 0 1.5.06l.3-7.5Z" clip-rule="evenodd" fill-rule="evenodd" />
                      </svg>
                      Delete
                      <% end %>
                    </div>
                  </el-menu>
                </el-dropdown>
              </div>
            </div>
            <!-- Description -->
            <p class="mt-3 text-sm text-gray-300/90"><%= c.description %></p>

            <!-- Footer: count badge -->
            <div class="mt-5 flex items-center">
              <% if c.respond_to?(:collection_cards) %>
                <span class="rounded-full bg-white/10 px-2 py-0.5 text-xs text-gray-200 inset-ring-1 inset-ring-white/10">
                  <%= c.collection_cards.size %> cards
                </span>
              <% end %>
            </div>

            <%# === Mini card previews (show up to 3) === %>
            <% preview_cards = c.collection_cards.includes(:card).first(3) %>
            <% if preview_cards.present? %>
              <div class="mt-4 grid grid-cols-3 gap-3">
                <% preview_cards.each do |collection_card| %>
                  <% card = collection_card.card %>
                  <div class="rounded-md overflow-hidden ring-1 ring-white/10 bg-white/5">
                    <!-- use your holo component mini, or swap to <img> if preferred -->
                    <%= link_to collection_card_path(collection_card) do %>
                      <div
                        class="pkm-holo h-28 w-full"
                        style="--front: url('<%= card.image_url %>')"
                        role="img"
                        aria-label="<%= card.name %>">
                      </div>
                    <% end %>
                  </div>
                <% end %>
              </div>
            <% end %>

            <div class="mt-5 ml-40">
              <%= link_to collection_path(c),
                  class: "inline-flex items-center justify-center gap-x-1.5 rounded-md bg-white/30 px-3 py-2 text-xs font-semibold text-white inset-ring-1 inset-ring-white/5 hover:bg-white/20 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-white/60",
                  role: "button" do %>
                <svg viewBox="0 0 20 20" fill="currentColor" aria-hidden="true" class="size-4 -ml-0.5">
                  <path d="M10 18a8 8 0 1 0 0-16 8 8 0 0 0 0 16ZM6.75 9.25a.75.75 0 0 0 0 1.5h4.59l-2.1 1.95a.75.75 0 0 0 1.02 1.1l3.5-3.25a.75.75 0 0 0 0-1.1l-3.5-3.25a.75.75 0 1 0-1.02 1.1l2.1 1.95H6.75Z" clip-rule="evenodd" fill-rule="evenodd" />
                </svg>
                Show Cards
              <% end %>
            </div>

          </article>
        <% end %>
      </div>
    </div>
    <!-- Horizontal scrollbar -->
    <div data-scroll-area-target="scrollbar"
         data-scroll-area-orientation-value="horizontal"
         data-action="click->scroll-area#onScrollbarClick"
         class="absolute bottom-1 left-2 right-2 flex h-1.5 items-center rounded-full bg-black/5 backdrop-blur-sm opacity-0 transition-opacity duration-150 delay-300 pointer-events-none data-[hovering]:opacity-100 data-[hovering]:duration-100 data-[hovering]:delay-0 data-[hovering]:pointer-events-auto data-[scrolling]:opacity-100 data-[scrolling]:duration-100 data-[scrolling]:delay-0 data-[scrolling]:pointer-events-auto data-[visible=false]:hidden dark:bg-white/10">
      <div data-scroll-area-target="thumb"
           data-action="mousedown->scroll-area#onThumbMouseDown"
           class="relative h-full rounded-full bg-neutral-500 transition-opacity duration-100 dark:bg-neutral-400">
      </div>
    </div>
  </div> 
</div>
