<div class="min-h-screen bg-cover bg-center" style="background-image: url('<%= image_path("wallpapers/pokemon_background.png") %>');">
  <main class="isolate">
    <!-- Hero section -->
    <div class="relative pt-10">
      <!-- Background-->
      <div aria-hidden="true" class="absolute inset-x-0 -top-40 -z-10 transform-gpu overflow-hidden blur-3xl sm:-top-80">
        <div style="clip-path: polygon(74.1% 44.1%, 100% 61.6%, 97.5% 26.9%, 85.5% 0.1%, 80.7% 2%, 72.5% 32.5%, 60.2% 62.4%, 52.4% 68.1%, 47.5% 58.3%, 45.2% 34.5%, 27.5% 76.7%, 0.1% 64.9%, 17.9% 100%, 27.6% 76.8%, 76.1% 97.7%, 74.1% 44.1%)"
          class="relative left-[calc(50%-11rem)] aspect-1155/678 w-144.5 -translate-x-1/2 rotate-30 bg-gradient-to-tr from-[#ff80b5] to-[#9089fc] opacity-30 sm:left-[calc(50%-30rem)] sm:w-288.75">
        </div>
      </div>

      <!-- Login Card -->
      <div class="py-1 sm:py-8 lg:pb-24">
        <div class="mx-auto max-w-7xl px-6 lg:px-8">
          <div class="mx-auto max-w-md group relative rounded-xl bg-white/5 ring-1 ring-white/30 p-6 pb-20">
            <h1 class="text-2xl md:text-2xl font-pokemon text-yellow-400 drop-shadow-[2px_2px_0px_#3B4CCA]">Welcome back, Trainer</h1><br>
            <h2 class="text-l md:text-l font-pokemon text-yellow-400 drop-shadow-[2px_2px_0px_#3B4CCA]">Log in to access your collection</h2>

            <div class="py-6">
            <%= simple_form_for(resource, as: resource_name, url: session_path(resource_name)) do |f| %>
              <%= f.error_notification %>

              <div class="space-y-4">
                <%= f.input :login,
                  required: true,
                  autofocus: true,
                  label: "Email or Username",
                  label_html: { class: "block text-sm font-medium text-white" },
                  input_html: { autocomplete: "username", class: "w-full rounded-md border-gray-300 py-1.5 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 sm:text-sm" }%>

                <%= f.input :password,
                  required: true,
                  hint: ("#{@minimum_password_length} characters minimum" if @minimum_password_length),
                  label_html: { class: "block text-sm font-medium text-white" },
                  input_html: { autocomplete: "new-password", class: "w-full rounded-md border-gray-300 py-1.5 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 sm:text-sm" } %>

                <%= render "components/button", button_label: "Log In", is_button: true %>
              </div>
            <% end %>
            </div>

            <div class="mt-2 text-sm">
              <%= link_to "Forgot your password?", new_password_path(resource_name), class: "text-gray-300 hover:text-white py-2" %><br>
              <div class="flex justify-end mt-12">
                <%= link_to "Don't have an account? Sign up", new_registration_path(resource_name), class: "text-gray-300 hover:text-white py-2" %>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </main>
</div>
