<div class="mx-auto max-w-md bg-white rounded-lg shadow-md px-4 pt-2 pb-2">
  <h2 class="text-xl font-bold text-gray-900 mb-1">Forgot your password?</h2>
  <h3 class="text-sm text-gray-700 mb-2">Enter your email to reset it</h3>

  <%= simple_form_for(resource, as: resource_name, url: password_path(resource_name), html: { method: :post }) do |f| %>
    <%= f.error_notification %>

    <div class="space-y-10">
      <%= f.input :email,
        required: true,
        autofocus: true,
        label_html: { class: "block text-sm font-medium text-gray-700 mb-1" },
        input_html: { autocomplete: "email", class: "w-full rounded-md border-gray-300 py-1 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 sm:text-sm" } %>

      <div class="flex justify-center mt-2">
        <%= render "components/button", button_label: "RESET PASSWORD", is_button: true %>
      </div>
    </div>
  <% end %>

  <div class="text-sm text-gray-600 mt-4">
    <div class="flex justify-center">
      <%= link_to "Back to login", new_session_path(resource_name), class: "text-indigo-600 hover:text-indigo-800" %>
    </div>
    <div class="flex justify-end mt-4">
      <%= link_to "Don't have an account? Sign up", new_registration_path(resource_name), class: "text-indigo-600 hover:text-indigo-800" %>
    </div>
  </div>
</div>
