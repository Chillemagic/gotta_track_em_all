<div class="my-16 mx-auto max-w-3/4 bg-white/30 backdrop-blur rounded-2xl p-8 ring-1 ring-white/5 shadow-2xl">
  <h2 class="text-2xl font-bold text-gray-900 mb-2">Change your password</h2>
  <h3 class="text-sm text-gray-900 mb-6">Enter and confirm your new password</h3>

  <%= simple_form_for(resource, as: resource_name, url: password_path(resource_name), html: { method: :put }) do |f| %>
    <%= f.error_notification %>

    <%= f.input :reset_password_token, as: :hidden %>
    <%= f.full_error :reset_password_token %>

    <div class="space-y-4">
      <%= f.input :password,
        label: "New password",
        required: true,
        autofocus: true,
        hint: ("#{@minimum_password_length} characters minimum" if @minimum_password_length),
        label_html: { class: "block text-sm font-medium text-gray-700" },
        input_html: {
          autocomplete: "new-password",
          class: "w-full rounded-md border-gray-300 py-1.5 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 sm:text-sm"
        } %>
      <%= f.input :password_confirmation,
        label: "Confirm your new password",
        required: true,
        label_html: { class: "block text-sm font-medium text-gray-700" },
        input_html: {
          autocomplete: "new-password",
          class: "w-full rounded-md border-gray-300 py-1.5 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 sm:text-sm"
        } %>

      <%= render "components/button",
            button_label: "Change my password",
            is_button: true,
            width: "w-full" %>
    </div>
  <% end %>

  <div class="mt-2 text-sm text-gray-600">
    <div class="flex justify-start">
      <%= link_to "Back to login",
                  new_session_path(resource_name),
                  class: "text-white hover:text-indigo-600 py-2" %>
    </div>
    <div class="flex justify-start mt-3">
      <%= link_to "Don't have an account? Sign up",
                  new_registration_path(resource_name),
                  class: "text-white hover:text-indigo-800 py-2" %>
    </div>
  </div>
</div>
