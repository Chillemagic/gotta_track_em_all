
<main class="isolate">
  <!-- Hero section -->
  <div class="max-[600px]:hidden relative pt-2">
    <div aria-hidden="true" class="absolute inset-x-0 -top-40 -z-10 transform-gpu overflow-hidden blur-3xl sm:-top-80">
      <div style="clip-path: polygon(74.1% 44.1%, 100% 61.6%, 97.5% 26.9%, 85.5% 0.1%, 80.7% 2%, 72.5% 32.5%, 60.2% 62.4%, 52.4% 68.1%, 47.5% 58.3%, 45.2% 34.5%, 27.5% 76.7%, 0.1% 64.9%, 17.9% 100%, 27.6% 76.8%, 76.1% 97.7%, 74.1% 44.1%)"
        class="relative left-[calc(50%-11rem)] aspect-1155/678 w-144.5 -translate-x-1/2 rotate-30 bg-gradient-to-tr from-[#ff80b5] to-[#9089fc] opacity-30 sm:left-[calc(50%-30rem)] sm:w-288.75">
      </div>
    </div>

    <!-- Edit Profile Card -->
    <div class="py-1 sm:py-8 lg:pb-8">
      <div class="mx-auto max-w-7xl px-6 lg:px-8">
        <div class="mx-auto max-w-5xl rounded-2xl bg-white/30 p-6 shadow-2xl ring-1 ring-white/5 backdrop-blur sm:p-8">
          <div class="mb-6">
            <h2 class="text-2xl font-bold text-gray-900">Edit Your Profile</h2>
          </div>

          <%= simple_form_for(resource, as: resource_name, url: registration_path(resource_name), html: { method: :put }) do |f| %>
            <%= f.error_notification %>

            <div class="grid gap-8 lg:grid-cols-2 lg:gap-12">
              <!-- Profile and password fields -->
              <section class="space-y-4">
                <h3 class="border-b border-gray-300 pb-2 text-lg font-semibold text-gray-900">Trainer details</h3>

                <%= f.input :first_name,
                  label_html: { class: "block text-sm font-medium text-gray-700" },
                  input_html: { class: "w-full rounded-md border-gray-300 py-1.5 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 sm:text-sm" } %>

                <%= f.input :last_name,
                  label_html: { class: "block text-sm font-medium text-gray-700" },
                  input_html: { class: "w-full rounded-md border-gray-300 py-1.5 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 sm:text-sm" } %>

                <%= f.input :username,
                  required: true,
                  label_html: { class: "block text-sm font-medium text-gray-700" },
                  input_html: { class: "w-full rounded-md border-gray-300 py-1.5 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 sm:text-sm" } %>

                <%= f.input :trainer_type,
                  collection: [["PokeScientist: Data-focussed", "pokescientist"], ["PokeManiac: Collector-focussed", "pokemaniac"]],
                  prompt: "Select your trainer type",
                  label_html: { class: "block text-sm font-medium text-gray-700" },
                  input_html: { class: "w-full rounded-md border-gray-300 py-1.5 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 sm:text-sm" } %>

                <%= f.input :password,
                  label: "New Password",
                  hint: "Leave blank if you don't want to change it",
                  label_html: { class: "block text-sm font-medium text-gray-700" },
                  hint_html: { class: "text-white" },
                  input_html: { autocomplete: "new-password", class: "w-full rounded-md border-gray-300 py-1.5 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 sm:text-sm" } %>

                <%= f.input :password_confirmation,
                  label: "Confirm New Password",
                  label_html: { class: "block text-sm font-medium text-gray-700" },
                  input_html: { autocomplete: "new-password", class: "w-full rounded-md border-gray-300 py-1.5 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 sm:text-sm" } %>

                <%= f.input :current_password,
                  hint: "Enter your current password to confirm changes",
                  label_html: { class: "block text-sm font-medium text-gray-700" },
                  hint_html: { class: "text-white" },
                  input_html: { autocomplete: "current-password", class: "w-full rounded-md border-gray-300 py-1.5 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 sm:text-sm" } %>
              </section>

              <!-- Avatar options -->
              <section>
                <h3 class="border-b border-gray-300 pb-2 text-lg font-semibold text-gray-900">Choose an avatar</h3>

                <div class="mt-4 grid grid-cols-3 gap-4 sm:grid-cols-4">
                  <% ["beauty_avatar.png", "bug_catcher_avatar.png", "black_belt_avatar.png", "fisherman_avatar.png", "hiker_avatar.png", "pokefan_f_avatar.png", "pokefan_m_avatar.png", "pokemaniac_avatar.png", "rocket_grunt_f_avatar.png", "rocket_grunt_m_avatar.png", "scientist_f_avatar.png", "scientist_m_avatar.png"].each do |icon| %>
                    <label class="block cursor-pointer text-center">
                      <%= f.radio_button :preset_avatar, icon, class: "peer sr-only" %>
                      <%= image_tag icon,
                        alt: "Avatar option",
                        class: "mx-auto h-16 w-16 rounded-full border-2 border-transparent object-cover shadow-sm transition hover:scale-105 peer-checked:border-indigo-500 peer-checked:ring-2 peer-checked:ring-indigo-300" %>
                    </label>
                  <% end %>
                </div>

                <div class="mt-8 flex flex-col-reverse gap-3 border-t border-gray-300 pt-6 sm:flex-row sm:justify-end">
                  <%= render "components/button", button_label: "Dashboard", button_path: root_path, width: "w-full sm:w-38" %>
                  <%= render "components/button", button_label: "Update Profile", is_button: true, width: "w-full sm:w-38" %>
                </div>
              </section>
            </div>
          <% end %>
        </div>
      </div>
    </div>
  </div>
  <!-- _________________________________________________________ WIP: Dropdown menu _______________________________________________________________________________________________________________________________________________________ -->

  <div class="min-[599px]:hidden my-4 mx-auto max-w-7xl px-6 lg:px-8">
    <%= simple_form_for(resource, as: resource_name, url: registration_path(resource_name), html: { method: :put }) do |f| %>
      <%= f.error_notification %>   
      <div class="mx-auto max-w-5xl rounded-2xl bg-white/30 p-6 shadow-2xl ring-1 ring-white/5 backdrop-blur sm:p-8" data-controller="accordion">
        <!-- Account details -->
        <section data-accordion-target="item" data-state="open" class="border-b pb-2 border-neutral-200 dark:border-neutral-700">
          <h3>
            <button
              type="button"
              data-accordion-target="trigger"
              data-action="click->accordion#toggle"
              aria-controls="account-details-content"
              aria-expanded="true"
              data-state="open"
              id="account-details-trigger"
              class="flex flex-1 items-center text-left justify-between py-2 font-medium transition-all hover:underline [&[data-state=open]>svg]:rotate-180 focus:outline-neutral-700 dark:focus:outline-white focus:outline-offset-2 px-2"
            >
              <span>
                Account Details
              </span>
              <svg xmlns="http://www.w3.org/2000/svg" data-accordion-target="icon" class="size-4 shrink-0 transition-transform duration-300" width="18" height="18" viewbox="0 0 18 18">
                <path
                  fill-rule="evenodd"
                  d="M5.23 7.21a.75.75 0 011.06.02L10
                  11.168l3.71-3.938a.75.75 0 111.08 1.04l-4.25
                  4.5a.75.75 0 01-1.08 0l-4.25-4.5a.75.75 0
                  01.02-1.06z"
                  clip-rule="evenodd"
                />
              </svg>
            </button>
          </h3>

          <div
            data-accordion-target="content"
            data-state="open"
            id="account-details-content"
            role="region"
            aria-labelledby="account-details-trigger"
            class="grid transition-[grid-template-rows] duration-300 ease-in-out data-[state=open]:grid-rows-[1fr] data-[state=closed]:grid-rows-[0fr]"
          >
            <div class="overflow-hidden min-h-0">
              <div 
                class="text-sm space-y-4 px-5 pb-5 opacity-0 transition-opacity duration-300 data-[state=open]:opacity-100" 
                data-state="open"
              >

                <!-- Profile and password fields -->
                <%= f.input :first_name,
                  label_html: { class: "block text-sm font-medium text-gray-700" },
                  input_html: { class: "w-full rounded-md border-gray-300 py-1.5 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 sm:text-sm" } %>

                <%= f.input :last_name,
                  label_html: { class: "block text-sm font-medium text-gray-700" },
                  input_html: { class: "w-full rounded-md border-gray-300 py-1.5 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 sm:text-sm" } %>

                <%= f.input :username,
                  required: true,
                  label_html: { class: "block text-sm font-medium text-gray-700" },
                  input_html: { class: "w-full rounded-md border-gray-300 py-1.5 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 sm:text-sm" } %>

                <%= f.input :trainer_type,
                  collection: [["PokeScientist: Data-focussed", "pokescientist"], ["PokeManiac: Collector-focussed", "pokemaniac"]],
                  prompt: "Select your trainer type",
                  label_html: { class: "block text-sm font-medium text-gray-700" },
                  input_html: { class: "w-full rounded-md border-gray-300 py-1.5 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 sm:text-sm" } %>

                <%= f.input :password,
                  label: "New Password",
                  hint: "Leave blank if you don't want to change it",
                  label_html: { class: "block text-sm font-medium text-gray-700" },
                  hint_html: { class: "text-white" },
                  input_html: { autocomplete: "new-password", class: "w-full rounded-md border-gray-300 py-1.5 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 sm:text-sm" } %>

                <%= f.input :password_confirmation,
                  label: "Confirm New Password",
                  label_html: { class: "block text-sm font-medium text-gray-700" },
                  input_html: { autocomplete: "new-password", class: "w-full rounded-md border-gray-300 py-1.5 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 sm:text-sm" } %>
                <%= f.input :current_password,
                  hint: "Enter your current password to confirm changes",
                  label_html: { class: "block text-sm font-medium text-gray-700" },
                  hint_html: { class: "text-white" },
                  input_html: { autocomplete: "current-password", class: "w-full rounded-md border-gray-300 py-1.5 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 sm:text-sm" } %>
              </div>
            </div>
          </div>
        </section>
      
        <!-- Avatar Section -->
        <section data-accordion-target="item" data-state="closed" class="border-b pb-2 border-neutral-200 dark:border-neutral-700">
          <h3>
            <button
              type="button"
              data-accordion-target="trigger"
              data-action="click->accordion#toggle"
              aria-controls="avatar-content"
              aria-expanded="false"
              data-state="closed"
              id="avatar-content-trigger"
              class="flex flex-1 items-center text-left justify-between py-2 font-medium transition-all hover:underline [&[data-state=open]>svg]:rotate-180 focus:outline-neutral-700 dark:focus:outline-white focus:outline-offset-2 px-2"
            >
              <span>Choose an avatar</span>
              
              <svg
                data-accordion-target="icon"
                class="h-5 w-5 transition-transform duration-
                300"
                viewBox="0 0 20 20"
                fill="currentColor"
                aria-hidden="true"
              >
                <path
                  fill-rule="evenodd"
                  d="M5.23 7.21a.75.75 0 011.06.02L10
                  11.168l3.71-3.938a.75.75 0 111.08 1.04l-4.25
                  4.5a.75.75 0 01-1.08 0l-4.25-4.5a.75.75 0
                  01.02-1.06z"
                  clip-rule="evenodd"
                />
              </svg>
            </button>
          </h3>
          <div
            id="avatar-content"
            class="grid transition-[grid-template-rows]
            duration-300 ease-in-out data-[state=open]:grid-
            rows-[1fr] data-[state=closed]:grid-rows-[0fr]"
            data-accordion-target="content"
            data-state="closed"
            role="region"
            aria-labelledby="avatar-trigger"
            hidden
          >
            <div class="min-h-0 overflow-hidden">
              <div
                class="px-5 pb-5 opacity-0 transition-opacity
                duration-300 data-[state=open]:opacity-100"
                data-state="closed"
              >
                <div class="mt-2 grid grid-cols-3 gap-4 sm:grid-
                cols-4">
                  <% [
                    "beauty_avatar.png",
                    "bug_catcher_avatar.png",
                    "black_belt_avatar.png",
                    "fisherman_avatar.png",
                    "hiker_avatar.png",
                    "pokefan_f_avatar.png",
                    "pokefan_m_avatar.png",
                    "pokemaniac_avatar.png",
                    "rocket_grunt_f_avatar.png",
                    "rocket_grunt_m_avatar.png",
                    "scientist_f_avatar.png",
                    "scientist_m_avatar.png"
                  ].each do |icon| %>
                    <label class="block cursor-pointer">
                      <%= f.radio_button :preset_avatar,
                        icon,
                        class: "peer sr-only" %>

                      <%= image_tag icon,
                        alt: "Avatar option",
                        class: "mx-auto h-16 w-16 rounded-full
                        border-2 border-transparent object-
                        cover shadow-sm peer-checked:border-
                        indigo-500 peer-checked:ring-2 peer-
                        checked:ring-indigo-300" %>
                    </label>
                  <% end %>
                </div> 
              </div>
            </div>
          </div>
        </section>
      </div>
      <%# Always-visible actions %>
      <div class="mt-6 flex flex-col-reverse gap-3 sm:flex-row
      sm:justify-end">
        <%= render "components/button",
          button_label: "Update Profile",
          is_button: true,
          width: "w-full sm:w-38" %>
      </div>
    <% end %>
  </div>
</main>
