<div class="mx-auto w-full max-w-md rounded-2xl bg-white/30 p-6 shadow-2xl ring-1 ring-white/5 backdrop-blur sm:p-8">
  <%= simple_form_for(collection_card) do |f| %>
    <%= f.error_notification %>
    <%= f.error_notification message: f.object.errors[:base].to_sentence if f.object.errors[:base].present? %>

    <div class="space-y-5">
      <%= f.association :collection,
            collection: current_user.collections.order(:name),
            label_method: :name,
            value_method: :id,
            include_blank: false,
            label: "Collection",
            label_html: { class: "text-white" },
            input_html: { class: "w-full rounded-md border border-gray-300 bg-white px-3 py-2 text-gray-900" } %>

      <%= f.input :favourite,
            as: :boolean,
            label: "Favourite",
            label_html: { class: "text-white" },
            input_html: { class: "size-4 rounded border-white/20 text-yellow-400 focus:ring-yellow-400" },
            wrapper_html: { class: "flex items-center gap-2" } %>

      <%= f.input :description,
            as: :text,
            label: "Description",
            label_html: { class: "text-white" },
            input_html: {
              rows: 5,
              class: "w-full rounded-md border border-gray-300 bg-white px-3 py-2 text-gray-900 placeholder:text-gray-400"
            } %>
    </div>

    <div class="mt-6 flex w-full items-center justify-between border-t border-white/10 pt-4">
      <%= render "components/button",
            button_label: "Confirm",
            width: "w-1/2" %>

      <% if collection_card.persisted? %>
        <div class="py-1">
          <%= link_to collection_card_path(collection_card),
                data: {
                  turbo_method: :delete,
                  turbo_confirm: "Delete this card from your collection?"
                },
                class: "group/item flex items-center px-4 py-2 text-sm text-white transition-colors hover:text-red-500 focus:bg-white/5 focus:text-red-500 focus:outline-hidden",
                role: "button" do %>
            <svg viewBox="0 0 20 20" fill="currentColor" data-slot="icon" aria-hidden="true" class="mr-3 size-5 text-white transition-colors group-hover/item:text-red-500 group-focus/item:text-red-500">
              <path d="M8.75 1A2.75 2.75 0 0 0 6 3.75v.443c-.795.077-1.584.176-2.365.298a.75.75 0 1 0 .23 1.482l.149-.022.841 10.518A2.75 2.75 0 0 0 7.596 19h4.807a2.75 2.75 0 0 0 2.742-2.53l.841-10.52.149.023a.75.75 0 0 0 .23-1.482A41.03 41.03 0 0 0 14 4.193V3.75A2.75 2.75 0 0 0 11.25 1h-2.5ZM10 4c.84 0 1.673.025 2.5.075V3.75c0-.69-.56-1.25-1.25-1.25h-2.5c-.69 0-1.25.56-1.25 1.25v.325C8.327 4.025 9.16 4 10 4ZM8.58 7.72a.75.75 0 0 0-1.5.06l.3 7.5a.75.75 0 1 0 1.5-.06l-.3-7.5Zm4.34.06a.75.75 0 1 0-1.5-.06l-.3 7.5a.75.75 0 1 0 1.5.06l.3-7.5Z" clip-rule="evenodd" fill-rule="evenodd" />
            </svg>
            Delete
          <% end %>
        </div>
      <% end %>
    </div>
  <% end %>
</div>
