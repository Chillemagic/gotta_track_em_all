
<!--__________ Under Construction _____-->
<div class="mx-auto max-w-5xl px-2 py-8">
  <div class="w-full flex">
    <div class="mx-auto">
      <h1 class="font-pokemon text-2xl justify-self-center min-[599px]:mb-2 mb-4 sm:text-3xl sm:justify-self-center md:text-4xl md:justify-self-center lg:text-5xl text-yellow-400 drop-shadow-[2px_2px_0px_#3B4CCA]">
        <%= @collection_card.card.name %>
      </h1>
    </div>
  </div>
  <!-- __________________________________WIP: Scroll Area ________________________________-->
  <div data-controller="scroll-area" data-scroll-area-target="root" data-action="mouseenter->scroll-area#onRootMouseEnter mouseleave->scroll-area#onRootMouseLeave" class="relative flex h-[70vh] w-full flex-col pb-5 sm:h-[75vh] lg:h-[80vh]">
    <div class="my-3 grid shrink-0 grid-cols-3" data-controller="toggle">
      <%# __________________________________________Heart Toggle_____________________________________________ %>
      <div class="flex items-center justify-self-start px-4">
        <label
          class="inline-flex items-center cursor-pointer select-none relative w-8 h-8">

          <input type="checkbox" class="sr-only peer" data-action="click->toggle#favourite" data-toggle-favourite-id-param="<%= @collection_card.id %>"
          data-toggle-favourite-current-param="<%= @collection_card.favourite? ? 'true' : 'false' %>"
          <%= 'checked' if @collection_card.favourite? %>
          />

          <!-- Outline Heart -->
          <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor"
                class="absolute inset-0 w-8 h-8 text-red-500 transition-all duration-200
                      peer-checked:opacity-0 peer-checked:scale-75">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5"
                  d="M21 8.25c0-2.485-2.099-4.5-4.688-4.5-1.935 0-3.597 1.126-4.312 2.733-.715-1.607-2.377-2.733-4.313-2.733C5.1 3.75 3 5.765 3 8.25c0 7.22 9 12 9 12s9-4.78 9-12Z" />
          </svg>

          <!-- Filled Heart -->
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor"
                class="absolute inset-0 w-8 h-8 text-red-500 opacity-0 scale-75 transition-all duration-200
                      peer-checked:opacity-100 peer-checked:scale-125">
            <path d="m11.645 20.91-.007-.003-.022-.012a15.247 15.247 0 0 1-.383-.218 25.18 25.18 0 0 1-4.244-3.17C4.688 15.36 2.25 12.174 2.25 8.25 2.25 5.322 4.714 3 7.688 3A5.5 5.5 0 0 1 12 5.052 5.5 5.5 0 0 1 16.313 3c2.973 0 5.437 2.322 5.437 5.25 0 3.925-2.438 7.111-4.739 9.256a25.175 25.175 0 0 1-4.244 3.17 15.247 15.247 0 0 1-.383.219l-.022.012-.007.004-.003.001a.752.752 0 0 1-.704 0l-.003-.001Z" />
          </svg>
        </label>
      </div>
      <div class="flex items-center justify-center gap-2 justify-self-center whitespace-nowrap">
        <h2 class="text-center text-sm">Scroll for details</h2>
        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="size-5 shrink-0">
          <path stroke-linecap="round" stroke-linejoin="round" d="m19.5 8.25-7.5 7.5-7.5-7.5" />
        </svg>
      </div>
      <!--___________Back Link _____-->
      <%= link_to collection_path(@collection_card.collection),
          class: "flex items-center justify-self-end px-4 py-2
    text-sm text-white transition-colors duration-200
    hover:text-yellow-400 focus:text-yellow-400
    focus:outline-none" do
      %>
          <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="size-6 shrink-0">
            <path stroke-linecap="round" stroke-linejoin="round" d="M9 15 3 9m0 0 6-6M3 9h12a6 6 0 0 1 0 12h-3" />
          </svg>
          <h2 class="ml-2">
            Back 
          </h2>
      <% end %>
    </div>
    <!-- Viewport -->
    <div class="relative min-h-0 flex-1 rounded-xl border border-black/10 bg-neutral-50 p-2 dark:border-white/10 dark:bg-neutral-900">
      <div class="h-full overflow-y-auto overflow-x-hidden py-4 pr-2 scrollbar-hide scroll-fade-y" data-scroll-area-target="viewport" data-action="scroll->scroll-area#onViewportScroll">
        <!--_________________WIP-LightBox___________________________-->
        <div class="flex w-full flex-col-reverse gap-8 py-1 sm:py-8 lg:pb-8" style="display: flex; flex-direction: column-reverse;">
          <div class="mx-auto w-full max-w-md rounded-2xl bg-white/30 p-6 shadow-2xl ring-1 ring-white/5 backdrop-blur sm:p-8" data-controller="accordion">
            <!-- Account details -->

            <% if @collection_card.card.pokemon_types.present? %>
              <section data-accordion-target="item" data-state="open" class="border-b pb-2 border-neutral-200 dark:border-neutral-700">
                <h3>
                  <button
                    type="button"
                    data-accordion-target="trigger"
                    data-action="click->accordion#toggle"
                    aria-controls="account-details-content"
                    aria-expanded="true"
                    data-state="open"
                    id="account-details-trigger"
                    class="flex flex-1 items-center text-left justify-between py-2 font-medium transition-all hover:underline [&[data-state=open]>svg]:rotate-180 focus:outline-neutral-700 dark:focus:outline-white focus:outline-offset-2 px-2"
                  >
                    <span>
                      Types
                    </span>
                    <svg xmlns="http://www.w3.org/2000/svg" data-accordion-target="icon" class="size-4 shrink-0 transition-transform duration-300" width="18" height="18" viewbox="0 0 18 18">
                      <path
                        fill-rule="evenodd"
                        d="M5.23 7.21a.75.75 0 011.06.02L10
                        11.168l3.71-3.938a.75.75 0 111.08 1.04l-4.25
                        4.5a.75.75 0 01-1.08 0l-4.25-4.5a.75.75 0
                        01.02-1.06z"
                        clip-rule="evenodd"
                      />
                    </svg>
                  </button>
                </h3>

                <div
                  data-accordion-target="content"
                  data-state="open"
                  id="account-details-content"
                  role="region"
                  aria-labelledby="account-details-trigger"
                  class="grid transition-[grid-template-rows] duration-300 ease-in-out data-[state=open]:grid-rows-[1fr] data-[state=closed]:grid-rows-[0fr]"
                >
                    <div class="overflow-hidden min-h-0">
                      <div
                        class="text-sm space-y-4 px-5 pb-5 opacity-0 transition-opacity duration-300 data-[state=open]:opacity-100"
                        data-state="open"
                      >
                        <!-- Pokemon Types -->
                        <h3 class="text-lg text-white">
                          Types:
                          <% types = @collection_card.card.pokemon_types.is_a?(Array) ? @collection_card.card.pokemon_types.join(', ') : @collection_card.card.pokemon_types %>
                          <%= types %>
                        </h3>
                      </div>
                    </div>
                </div>
              </section>
            <% end %>
            <% if @collection_card.card.abilities.present? %>
              <section data-accordion-target="item" data-state="open" class="border-b pb-2 border-neutral-200 dark:border-neutral-700">
                <h3>
                  <button
                    type="button"
                    data-accordion-target="trigger"
                    data-action="click->accordion#toggle"
                    aria-controls="account-details-content"
                    aria-expanded="true"
                    data-state="open"
                    id="account-details-trigger"
                    class="flex flex-1 items-center text-left justify-between py-2 font-medium transition-all hover:underline [&[data-state=open]>svg]:rotate-180 focus:outline-neutral-700 dark:focus:outline-white focus:outline-offset-2 px-2"
                  >
                    <span>
                      Abilities
                    </span>
                    <svg xmlns="http://www.w3.org/2000/svg" data-accordion-target="icon" class="size-4 shrink-0 transition-transform duration-300" width="18" height="18" viewbox="0 0 18 18">
                      <path
                        fill-rule="evenodd"
                        d="M5.23 7.21a.75.75 0 011.06.02L10
                        11.168l3.71-3.938a.75.75 0 111.08 1.04l-4.25
                        4.5a.75.75 0 01-1.08 0l-4.25-4.5a.75.75 0
                        01.02-1.06z"
                        clip-rule="evenodd"
                      />
                    </svg>
                  </button>
                </h3>
                <div
                  data-accordion-target="content"
                  data-state="open"
                  id="account-details-content"
                  role="region"
                  aria-labelledby="account-details-trigger"
                  class="grid transition-[grid-template-rows] duration-300 ease-in-out data-[state=open]:grid-rows-[1fr] data-[state=closed]:grid-rows-[0fr]"
                >
                  <div class="overflow-hidden min-h-0">
                    <div
                      class="text-sm space-y-4 px-5 pb-5 opacity-0 transition-opacity duration-300 data-[state=open]:opacity-100"
                      data-state="open"
                    >
                      <h3 class="text-xl font-semibold text-white mb-2">Abilities</h3>
                        <ul class="list-disc ml-6">
                          <% @collection_card.card.abilities.each do |ability| %>
                            <li class="mb-2">
                              <strong class="text-white"><%= ability['name'] %></strong>
                              <% if ability['text'].present? %>
                                <br>
                                <span class="text-sm text-gray-200"><%= ability['text'] %></span>
                              <% end %>
                            </li>
                          <% end %>
                        </ul>
                    </div>
                  </div>
                </div>
              </section>
            <% end %>

            <% if @collection_card.card.attacks.present? %>
              <section data-accordion-target="item" data-state="open" class="border-b pb-2 border-neutral-200 dark:border-neutral-700">
                <h3>
                  <button
                    type="button"
                    data-accordion-target="trigger"
                    data-action="click->accordion#toggle"
                    aria-controls="account-details-content"
                    aria-expanded="true"
                    data-state="open"
                    id="account-details-trigger"
                    class="flex flex-1 items-center text-left justify-between py-2 font-medium transition-all hover:underline [&[data-state=open]>svg]:rotate-180 focus:outline-neutral-700 dark:focus:outline-white focus:outline-offset-2 px-2"
                  >
                    <span>
                      Attacks
                    </span>
                    <svg xmlns="http://www.w3.org/2000/svg" data-accordion-target="icon" class="size-4 shrink-0 transition-transform duration-300" width="18" height="18" viewbox="0 0 18 18">
                      <path
                        fill-rule="evenodd"
                        d="M5.23 7.21a.75.75 0 011.06.02L10
                        11.168l3.71-3.938a.75.75 0 111.08 1.04l-4.25
                        4.5a.75.75 0 01-1.08 0l-4.25-4.5a.75.75 0
                        01.02-1.06z"
                        clip-rule="evenodd"
                      />
                    </svg>
                  </button>
                </h3>
                <div
                data-accordion-target="content"
                data-state="open"
                id="account-details-content"
                role="region"
                aria-labelledby="account-details-trigger"
                class="grid transition-[grid-template-rows] duration-300 ease-in-out data-[state=open]:grid-rows-[1fr] data-[state=closed]:grid-rows-[0fr]"
                >
                <div class="overflow-hidden min-h-0">
                  <div
                    class="text-sm space-y-4 px-5 pb-5 opacity-0 transition-opacity duration-300 data-[state=open]:opacity-100"
                    data-state="open"
                  >
                    <ul class="list-disc ml-6">
                      <% @collection_card.card.attacks.each do |attack| %>
                        <li class="mb-2">
                          <strong class="text-white"><%= attack['name'] %></strong>
                          <% if attack['effect'].present? %>
                            <br>
                            <span class="text-sm text-gray-200"><%= attack['effect'] %></span>
                          <% end %>
                        </li>
                      <% end %>
                    </ul>
                  </div>
                </div>
                </div>
              </section>
            <% end %>

            <section data-accordion-target="item" data-state="open" class="border-b pb-2 border-neutral-200 dark:border-neutral-700">
              <h3>
                <button
                  type="button"
                  data-accordion-target="trigger"
                  data-action="click->accordion#toggle"
                  aria-controls="account-details-content"
                  aria-expanded="true"
                  data-state="open"
                  id="account-details-trigger"
                  class="flex flex-1 items-center text-left justify-between py-2 font-medium transition-all hover:underline [&[data-state=open]>svg]:rotate-180 focus:outline-neutral-700 dark:focus:outline-white focus:outline-offset-2 px-2"
                >
                  <span>
                    Set Info
                  </span>
                  <svg xmlns="http://www.w3.org/2000/svg" data-accordion-target="icon" class="size-4 shrink-0 transition-transform duration-300" width="18" height="18" viewbox="0 0 18 18">
                    <path
                      fill-rule="evenodd"
                      d="M5.23 7.21a.75.75 0 011.06.02L10
                      11.168l3.71-3.938a.75.75 0 111.08 1.04l-4.25
                      4.5a.75.75 0 01-1.08 0l-4.25-4.5a.75.75 0
                      01.02-1.06z"
                      clip-rule="evenodd"
                    />
                  </svg>
                </button>
              </h3>
              <div
                data-accordion-target="content"
                data-state="open"
                id="account-details-content"
                role="region"
                aria-labelledby="account-details-trigger"
                class="grid transition-[grid-template-rows] duration-300 ease-in-out data-[state=open]:grid-rows-[1fr] data-[state=closed]:grid-rows-[0fr]"
                >
                <div class="overflow-hidden min-h-0">
                  <div
                    class="text-sm space-y-4 px-5 pb-5 opacity-0 transition-opacity duration-300 data-[state=open]:opacity-100"
                    data-state="open"
                  >
                    <p><span class="font-semibold underline">Set:</span> <%= @collection_card.card.set_name %></p>
                    <p><span class="font-semibold underline">Release Date:</span> <%= @collection_card.card.release_date %></p>
                    <p><span class="font-semibold underline">Rarity:</span> <%= @collection_card.card.rarity %></p>
                    <% if @collection_card.card.artist.present? %>
                      <p><span class="font-semibold underline">Artist:</span> <%= @collection_card.card.artist %></p>
                    <% end %>
                  </div>
                </div>
              </div>
            </section>
            <% if @collection_card.card.price_histories.exists? %>
              <section
                data-accordion-target="item"
                data-state="closed"
                class="border-b pb-2 border-neutral-200 dark:border-neutral-700"
              >
                <h3>
                  <button
                    type="button"
                    data-accordion-target="trigger"
                    data-action="click->accordion#toggle"
                    aria-controls="pricing-content"
                    aria-expanded="false"
                    data-state="closed"
                    id="pricing-trigger"
                    class="flex flex-1 items-center text-left justify-between py-2 font-medium transition-all hover:underline [&[data-state=open]>svg]:rotate-180 focus:outline-neutral-700 dark:focus:outline-white focus:outline-offset-2 px-2"
                  >
                    <span>
                      Price history
                    </span>
                    <svg xmlns="http://www.w3.org/2000/svg" data-accordion-target="icon" class="size-4 shrink-0 transition-transform duration-300" width="18" height="18" viewbox="0 0 18 18">
                      <path
                        fill-rule="evenodd"
                        d="M5.23 7.21a.75.75 0 011.06.02L10
                        11.168l3.71-3.938a.75.75 0 111.08 1.04l-4.25
                        4.5a.75.75 0 01-1.08 0l-4.25-4.5a.75.75 0
                        01.02-1.06z"
                        clip-rule="evenodd"
                      />
                    </svg>
                  </button>
                </h3>

                <div
                  id="pricing-content"
                  role="region"
                  aria-labelledby="pricing-trigger"
                  data-accordion-target="content"
                  data-state="closed"
                  class="grid grid-rows-[0fr] transition-[grid-template-rows] duration-300 ease-in-out data-[state=open]:grid-rows-[1fr] data-[state=closed]:grid-rows-[0fr]"
                >
                  <div class="min-h-0 overflow-hidden">
                    <div
                      data-state="closed"
                      class="space-y-4 px-5 pb-5 text-sm opacity-0 transition-opacity duration-300 data-[state=open]:opacity-100"
                    >
                      <div class="rounded-lg bg-white/10 p-4 ring-1 ring-white/10">
                        <p class="text-gray-300">Estimated value</p>

                        <p class="mt-1 text-3xl font-bold text-white">
                          <%= @selected_price.present? ?
                          number_to_currency(@selected_price) :
                          "N/A" %>
                        </p>

                        <p class="mt-2 text-gray-300">
                          Condition:
                          <span class="font-semibold">
                            <%=
                            @collection_card.condition.presence ||
                            "Not specified" %>
                          </span>
                        </p>
                      </div>

                      <ul class="divide-y divide-white/10">
                        <%
                        @collection_card.card.price_histories.order(recorded_at: :desc).each do |
                        price_history| %>
                          <li class="py-3">
                            <p class="font-semibold text-white">
                              <%= price_history.recorded_at ||
                              price_history.created_at.to_date %>
                            </p>

                            <% if
                            price_history.pokedata_raw_price.present? %>
                              <p class="text-gray-300">
                                Raw:
                                <%=
                                number_to_currency(price_history.pokedata_raw_price) %>
                              </p>
                            <% end %>

                            <% if price_history.source.present? %>
                              <p class="text-xs text-gray-400">
                                Source: <%= price_history.source
                                %>
                              </p>
                            <% end %>
                          </li>
                        <% end %>
                      </ul>
                    </div>
                  </div>
                </div>
              </section>
            <% end %>

            <% if @collection_card.description.present? %>
              <section
                data-accordion-target="item"
                data-state="closed"
                class="border-b pb-2 border-neutral-200 dark:border-neutral-700"
              >
                <h3>
                  <button
                    type="button"
                    id="description-trigger"
                    aria-controls="description-content"
                    aria-expanded="false"
                    data-state="closed"
                    data-accordion-target="trigger"
                    data-action="click->accordion#toggle"
                    class="flex w-full items-center justify-between px-2 py-2 text-left font-medium transition-all hover:underline [&[data-state=open]>svg]:rotate-180"
                  >
                    <span>Description</span>

                    <svg
                      xmlns="http://www.w3.org/2000/svg"
                      data-accordion-target="icon"
                      class="size-4 shrink-0 transition-transform duration-300"
                      viewBox="0 0 18 18"
                    >
                      <path
                        fill-rule="evenodd"
                        d="M5.23 7.21a.75.75 0 011.06.02L10 11.168l3.71-3.938a.75.75 0 111.08 1.04l-4.25 4.5a.75.75 0 01-1.08 0l-4.25-4.5a.75.75 0 01.02-1.06z"
                        clip-rule="evenodd"
                      />
                    </svg>
                  </button>
                </h3>

                <div
                  id="description-content"
                  role="region"
                  aria-labelledby="description-trigger"
                  data-accordion-target="content"
                  data-state="closed"
                  class="grid grid-rows-[0fr] transition-[grid-template-rows] duration-300 ease-in-out data-[state=open]:grid-rows-[1fr] data-[state=closed]:grid-rows-[0fr]"
                >
                  <div class="min-h-0 overflow-hidden">
                    <div
                      data-state="closed"
                      class="px-5 pb-5 text-sm leading-relaxed text-gray-200 opacity-0 transition-opacity duration-300 data-[state=open]:opacity-100"
                    >
                      <%=
                      simple_format(@collection_card.description)
                      %>
                    </div>
                  </div>
                </div>
              </section>
            <% end %>
          </div> <!-- Acordion End -->
          <!-- lightbox begins -->
          <div class="mx-auto w-full max-w-md">
            <div class="w-full">
              <div>
                <div class="flex justify-center">
                  <a href="<%= @collection_card.card.image_url %>"
                    data-controller="lightbox"
                    data-lightbox-target="trigger"
                    data-pswp-src="<%= @collection_card.card.image_url %>"
                    data-pswp-caption="<%= @collection_card.card.name %>"
                    class="block w-full max-w-md"
                  >
                    <div  class="pkm-holo mx-auto h-[calc(55vh-8rem)] max-h-[36rem] rounded-md sm:h-[calc(65vh-8rem)] lg:h-[calc(75vh-9rem)]"
                          style="--front: url('<%=
                          @collection_card.card.image_url %>'); width: auto;"
                          role="img"
                          aria-label="<%= @collection_card.card.name %>"
                    >
                      <%= image_tag @collection_card.card.image_url,
                          alt: "",
                          class: "invisible w-full h-auto",
                          aria: { hidden: true }
                      %>
                    </div>
                  </a>
                </div>
                <div class="w-full">
                  <div class="flex items-center justify-center">
                    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="size-4">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 3.75v4.5m0-4.5h4.5m-4.5 0L9 9M3.75 20.25v-4.5m0 4.5h4.5m-4.5 0L9 15M20.25 3.75h-4.5m4.5 0v4.5m0-4.5L15 9m5.25 11.25h-4.5m4.5 0v-4.5m0 4.5L15 15" />
                    </svg>
                    <h2 class="p-2 text-sm">Touch Card To Expand</h2>

                  </div>
                </div>
              </div>
            </div>
          </div> <!-- lightbox ends -->
        </div> <!-- col-2 -->
      </div> <!-- Scrolling Div end-->

      <!-- Vertical scrollbar -->
      <div data-scroll-area-target="scrollbar"
          data-scroll-area-orientation-value="vertical"
          data-action="click->scroll-area#onScrollbarClick"
          class="absolute bottom-2 right-2 top-2 flex w-1.5 justify-center rounded-full bg-black/5 opacity-0 backdrop-blur-sm transition-opacity duration-150 delay-300 pointer-events-none data-[hovering]:opacity-100 data-[hovering]:duration-100 data-[hovering]:delay-0 data-[hovering]:pointer-events-auto data-[scrolling]:opacity-100 data-[scrolling]:duration-100 data-[scrolling]:delay-0 data-[scrolling]:pointer-events-auto data-[visible=false]:hidden dark:bg-white/10">
        <div data-scroll-area-target="thumb"
            data-action="mousedown->scroll-area#onThumbMouseDown"
            class="relative w-full rounded-full bg-neutral-500 transition-opacity duration-100 dark:bg-neutral-400">
        </div>
      </div>
    </div> <!-- Viewport Container End -->
  </div> <!-- Data controller container -->
  <div class="w-full flex justify-between">
    <%= render "components/button", button_label: "Edit Card", button_path: edit_collection_card_path(@collection_card), width: "w-1/3" %>
    <div class="py-1">
      <%= link_to collection_card_path(@collection_card), data: { turbo_method: :delete, turbo_confirm: "Delete this card?" },
                  class: "group/item flex items-center px-4 py-2 text-sm text-gray-300 focus:bg-white/5 focus:text-white focus:outline-hidden",
