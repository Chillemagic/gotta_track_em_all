<!-- ___________________________WIP:Display Card____________________________-->
 <div class="container">
    <div class="mx-auto mt-6 max-w-7xl px-4 sm:px-6
    lg:px-8">
      <div
        id="card_<%= @collection_card.id %>"
        class="grid grid-cols-1 gap-8 lg:grid-cols-3
        lg:items-start"
      >
        <%# Card image — one third of the layout on
        large screens %>
        <section class="lg:col-span-1">
          <a
            href="<%= @collection_card.card.image_url
            %>"
            data-controller="lightbox"
            data-lightbox-target="trigger"
            data-pswp-src="<%=
            @collection_card.card.image_url %>"
            data-pswp-caption="<%=
            "#{@collection_card.card.name}
            #{@collection_card.card.card_number}".strip
            %>"
            class="group mx-auto block w-full max-w-md
            cursor-zoom-in"
            aria-label="Expand image of <%=
            @collection_card.card.name %>"
          >
            <div
              class="pkm-holo w-full rounded-md shadow-
              2xl ring-1 ring-white/10 transition
              duration-300 group-hover:scale-[1.02]
              group-focus-visible:outline group-focus-
              visible:outline-2 group-focus-
              visible:outline-offset-4 group-focus-
              visible:outline-yellow-400"
              style="--front: url('<%=
              @collection_card.card.image_url %>')"
              role="img"
              aria-label="<%= @collection_card.card.name
              %>"
            >
              <%= image_tag(
                @collection_card.card.image_url,
                alt: "",
                class: "invisible h-auto w-full",
                aria: { hidden: true }
              ) %>
            </div>
          </a>

          <p class="mt-3 text-center text-sm text-gray-
          300">
            Select the card to enlarge
          </p>
        </section>

        <%# Card details — two thirds of the layout on
        large screens %>
        <section class="rounded-2xl bg-white/30 p-6
        shadow-2xl ring-1 ring-white/5 backdrop-blur
        sm:p-8 lg:col-span-2">
          <header class="mb-6 flex items-start justify-
          between gap-4">
            <div>
              <p class="mb-1 text-sm font-medium
              uppercase tracking-wider text-gray-700">
                <%= @collection_card.card.set_name %>
              </p>

              <h1 class="text-3xl font-bold text-gray-
              900">
                <%= @collection_card.card.name %>
                <% if
                @collection_card.card.card_number.presen
                t? %>
                  <span class="text-yellow-500">
                    #<%=
                    @collection_card.card.card_number %>
                  </span>
                <% end %>
              </h1>
            </div>

            <div data-controller="toggle">
              <label
                class="relative inline-flex h-9 w-9
                shrink-0 cursor-pointer select-none
                items-center"
                aria-label="Favourite <%=
                @collection_card.card.name %>"
              >
                <input
                  type="checkbox"
                  class="peer sr-only"
                  data-action="click->toggle#favourite"
                  data-toggle-favourite-id-param="<%=
                  @collection_card.id %>"
                  data-toggle-favourite-current-
                  param="<%= @collection_card.favourite?
                  %>"
                  <%= "checked" if
                  @collection_card.favourite? %>
                >

                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  fill="none"
                  viewBox="0 0 24 24"
                  stroke="currentColor"
                  class="absolute inset-0 h-9 w-9 text-
                  red-500 transition-all duration-200
                  peer-checked:scale-75 peer-
                  checked:opacity-0"
                  aria-hidden="true"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="1.5"
                    d="M21 8.25c0-2.485-2.099-4.5-4.688-
                    4.5-1.935 0-3.597 1.126-4.312
                    2.733-.715-1.607-2.377-2.733-4.313-
                    2.733C5.1 3.75 3 5.765 3 8.25c0 7.22
                    9 12 9 12s9-4.78 9-12Z"
                  />
                </svg>

                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  viewBox="0 0 24 24"
                  fill="currentColor"
                  class="absolute inset-0 h-9 w-9 scale-
                  75 text-red-500 opacity-0 transition-
                  all duration-200 peer-checked:scale-
                  110 peer-checked:opacity-100"
                  aria-hidden="true"
                >
                  <path d="m11.645
                  20.91-.007-.003-.022-.012a15.247
                  15.247 0 0 1-.383-.218 25.18 25.18 0 0
                  1-4.244-3.17C4.688 15.36 2.25 12.174
                  2.25 8.25 2.25 5.322 4.714 3 7.688
                  3A5.5 5.5 0 0 1 12 5.052 5.5 5.5 0 0 1
                  16.313 3c2.973 0 5.437 2.322 5.437
                  5.25 0 3.925-2.438 7.111-4.739
                  9.256a25.175 25.175 0 0 1-4.244 3.17
                  15.247 15.247 0 0
                  1-.383.219l-.022.012-.007.004-.003.001
                  a.752.752 0 0 1-.704 0l-.003-.001Z" />
                </svg>
              </label>
            </div>
          </header>

          <% accordion_item = lambda do |id:, title:,
          open: false, &body| %>
            <% state = open ? "open" : "closed" %>

            <section
              data-accordion-target="item"
              data-state="<%= state %>"
              class="border-b border-neutral-200 pb-2
              dark:border-neutral-700"
            >
              <h2>
                <button
                  type="button"
                  id="<%= id %>-trigger"
                  data-accordion-target="trigger"
                  data-action="click->accordion#toggle"
                  data-state="<%= state %>"
                  aria-controls="<%= id %>-content"
                  aria-expanded="<%= open %>"
                  class="flex w-full flex-1 items-center
                  justify-between px-2 py-3 text-left
                  font-semibold text-gray-900
                  transition-all hover:underline
                  focus:outline-neutral-700
                  focus:outline-offset-2"
                >
                  <span><%= title %></span>

                  <svg
                    xmlns="http://www.w3.org/2000/svg"
                    data-accordion-target="icon"
                    class="size-4 shrink-0 transition-
                    transform duration-300 <%= "rotate-
                    180" if open %>"
                    width="18"
                    height="18"
                    viewBox="0 0 18 18"
                    aria-hidden="true"
                  >
                    <path
                      fill-rule="evenodd"
                      d="M5.23 7.21a.75.75 0
                      011.06.02L10 11.168l3.71-
                      3.938a.75.75 0 111.08 1.04l-4.25
                      4.5a.75.75 0 01-1.08 0l-4.25-
                      4.5a.75.75 0 01.02-1.06z"
                      clip-rule="evenodd"
                    />
                  </svg>
                </button>
              </h2>

              <div
                id="<%= id %>-content"
                data-accordion-target="content"
                data-state="<%= state %>"
                role="region"
                aria-labelledby="<%= id %>-trigger"
                class="grid transition-[grid-template-
                rows] duration-300 ease-in-out
                data-[state=open]:grid-rows-[1fr]
                data-[state=closed]:grid-rows-[0fr]"
                <%= "hidden" unless open %>
              >
                <div class="min-h-0 overflow-hidden">
                  <div
                    data-state="<%= state %>"
                    class="px-5 pb-5 text-sm text-gray-
                    800 opacity-0 transition-opacity
                    duration-300
                    data-[state=open]:opacity-100"
                  >
                    <%= capture(&body) %>
                  </div>
                </div>
              </div>
            </section>
          <% end %>

          <div data-controller="accordion" data-
          accordion-allow-multiple-value="true">
            <% if
            @collection_card.card.pokemon_types.present?
            %>
              <%= accordion_item.call(id: "pokemon-
              types", title: "Pokémon Types", open:
              true) do %>
                <% types =
                @collection_card.card.pokemon_types.is_a
                ?(Array) ?
                @collection_card.card.pokemon_types :
                @collection_card.card.pokemon_types.to_s
                .split(",") %>

                <div class="flex flex-wrap gap-2 pt-1">
                  <% types.each do |type| %>
                    <span class="rounded-full bg-yellow-
                    400/90 px-3 py-1 font-semibold text-
                    gray-900 shadow-sm ring-1 ring-
                    yellow-500/30">
                      <%= type.to_s.strip %>
                    </span>
                  <% end %>
                </div>
              <% end %>
            <% end %>

            <% if
            @collection_card.card.abilities.present? %>
              <%= accordion_item.call(id: "abilities",
              title: "Abilities") do %>
                <div class="space-y-4">
                  <%
                  @collection_card.card.abilities.each
                  do |ability| %>
                    <article class="rounded-lg bg-
                    white/25 p-4 ring-1 ring-white/20">
                      <h3 class="font-semibold text-
                      gray-900">
                        <%= ability["name"] %>
                      </h3>

                      <% if ability["text"].present? %>
                        <p class="mt-1 leading-relaxed">
                          <%= ability["text"] %>
                        </p>
                      <% end %>
                    </article>
                  <% end %>
                </div>
              <% end %>
            <% end %>

            <% if @collection_card.card.attacks.present?
            %>
              <%= accordion_item.call(id: "attacks",
              title: "Attacks") do %>
                <div class="space-y-4">
                  <% @collection_card.card.attacks.each
                  do |attack| %>
                    <article class="rounded-lg bg-
                    white/25 p-4 ring-1 ring-white/20">
                      <div class="flex flex-wrap items-
                      start justify-between gap-2">
                        <h3 class="font-semibold text-
                        gray-900">
                          <%= attack["name"] %>
                        </h3>

                        <% if attack["damage"].present?
                        %>
                          <span class="rounded-md bg-
                          red-500/90 px-2 py-1 font-bold
                          text-white">
                            <%= attack["damage"] %>
                            damage
                          </span>
                        <% end %>
                      </div>

                      <% if attack["cost"].present? %>
                        <p class="mt-2">
                          <span class="font-
                          semibold">Energy cost:</span>
                          <%= attack["cost"].join(", ")
                          %>
                        </p>
                      <% end %>

                      <% if attack["effect"].present? %>
                        <p class="mt-2 leading-relaxed">
                          <%= attack["effect"] %>
                        </p>
                      <% end %>
                    </article>
                  <% end %>
                </div>
              <% end %>
            <% end %>

            <%= accordion_item.call(id: "card-metadata",
            title: "Card Metadata") do %>
              <dl class="grid grid-cols-1 gap-x-6 gap-y-
              3 sm:grid-cols-2">
                <div>
                  <dt class="font-semibold text-gray-
                  900">Set</dt>
                  <dd><%=
                  @collection_card.card.set_name.presenc
                  e || "Not available" %></dd>
                </div>

                <div>
                  <dt class="font-semibold text-gray-
                  900">Card number</dt>
                  <dd><%=
                  @collection_card.card.card_number.pres
                  ence || "Not available" %></dd>
                </div>

                <div>
                  <dt class="font-semibold text-gray-
                  900">Release date</dt>
                  <dd><%=
                  @collection_card.card.release_date.pre
                  sence || "Not available" %></dd>
                </div>

                <div>
                  <dt class="font-semibold text-gray-
                  900">Rarity</dt>
                  <dd><%=
                  @collection_card.card.rarity.presence
                  || "Not available" %></dd>
                </div>

                <% if
                @collection_card.card.artist.present? %>
                  <div>
                    <dt class="font-semibold text-gray-
                    900">Artist</dt>
                    <dd><%= @collection_card.card.artist
                    %></dd>
                  </div>
                <% end %>

                <div>
                  <dt class="font-semibold text-gray-
                  900">Condition</dt>
                  <dd><%=
                  @collection_card.condition.presence ||
                  "Not specified" %></dd>
                </div>
              </dl>
            <% end %>

            <% if
            @collection_card.card.price_histories.any?
            %>
              <%= accordion_item.call(id: "pricing",
              title: "Pricing") do %>
                <div class="rounded-lg bg-white/25 p-4
                ring-1 ring-white/20">
                  <p class="text-sm text-gray-
                  700">Estimated value</p>

                  <p class="mt-1 text-3xl font-bold
                  text-gray-900">
                    <%= @selected_price.present? ?
                    number_to_currency(@selected_price)
                    : "N/A" %>
                  </p>

                  <p class="mt-2 text-gray-700">
                    Based on the selected
                    <span class="font-semibold"><%=
                    @collection_card.condition %></span>
                    condition.
                  </p>
                </div>
              <% end %>
            <% end %>

            <% if @collection_card.description.present?
            %>
              <%= accordion_item.call(id: "description",
              title: "Description") do %>
                <div class="leading-relaxed">
                  <%=
                  simple_format(@collection_card.descrip
                  tion, {}, wrapper_tag: "div") %>
                </div>
              <% end %>
            <% end %>
          </div>

          <footer class="mt-8 flex flex-col-reverse gap-
          3 border-t border-gray-300 pt-6 sm:flex-row
          sm:justify-between">
            <%= render(
              "components/button",
              button_label: "Back",
              button_path: collection_path(@collection),
              width: "w-full sm:w-38"
            ) %>

            <button
              type="button"
              class="w-full rounded-md bg-red-600 px-4
              py-2 font-medium text-white shadow-sm
              transition hover:bg-red-700 focus:outline-
              none focus:ring-2 focus:ring-red-500
              focus:ring-offset-2 sm:w-auto"
              onclick="document.getElementById('delete-
              modal').classList.remove('hidden')"
            >
              Delete Card
            </button>
          </footer>
        </section>
      </div>
    </div>
  </div>

  <div
    id="delete-modal"
    class="fixed inset-0 z-50 hidden items-center
    justify-center bg-black/60 p-4 backdrop-blur-sm"
    role="dialog"
    aria-modal="true"
    aria-labelledby="delete-modal-title"
  >
    <div class="w-full max-w-md rounded-2xl bg-gray-
    800/95 p-6 text-white shadow-2xl ring-1 ring-
    white/10">
      <h2 id="delete-modal-title" class="text-xl font-
      bold">
        Confirm deletion
      </h2>

      <p class="mt-3 text-gray-200">
        Are you sure you want to delete
        <strong><%= @collection_card.card.name %></
        strong>
        from your collection?
      </p>

      <div class="mt-6 flex flex-col-reverse gap-3
      sm:flex-row sm:justify-end">
        <button
          type="button"
          class="rounded-md bg-gray-200 px-4 py-2 font-
          medium text-gray-900 transition hover:bg-gray-
          300"
          onclick="document.getElementById('delete-
          modal').classList.add('hidden')"
        >
          Cancel
        </button>

        <%= button_to(
          "Confirm Delete",
          collection_card_path(@collection_card),
          method: :delete,
          form_class: "inline",
          class: "w-full rounded-md bg-red-600 px-4 py-2
          font-medium text-white transition hover:bg-
          red-700 sm:w-auto"
        ) %>
      </div>
    </div>
  </div>
