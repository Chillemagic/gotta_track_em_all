<% content_for :title, "Collection cards" %>

<h1>Collection cards</h1>

<div id="collection_cards">
  <% @collection_cards.each do |collection_card| %>
    <%= render collection_card %>
    <p>
      <%= link_to "Show this collection card", collection_card %>
    </p>
  <% end %>
</div>

<%= link_to "New collection card", new_collection_card_path %>
