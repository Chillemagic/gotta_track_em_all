<%= turbo_frame_tag "newCollection" do %>
  <div data-controller="collection-form">
    <div>
      <h1>
      <%= simple_form_for @collection_card, data: { turbo_frame: "_top" } do |f| %>
        <%= render "cards/collection_select", f: f, card: @card %>
      <% end %>
    </div>
    <%# Create new collection checkbox and form %>
    <div class="mt-3">
      <label class="flex items-center gap-2">
        <%= check_box_tag "create_new_collection", "1", false,
            data: { action: "collection-form#toggle" } %>
        <span>Create a new collection</span>
      </label>
    </div>

    <%# New collection form (hidden by default) %>
    <div class="hidden mt-4 bg-white/10 backdrop-blur rounded-lg border border-white/20 p-6 ring-1 ring-white/5" data-collection-form-target="newCollection">
        <div class="text-center">
          <h2 class="text-white">Add Card To Collection:</h2>
        </div>
      <%= simple_form_for @collection do |c| %>
        <%= c.input :name,
                    label_html: { class: "text-white"}  %>
        <%= c.input :description,
                      label_html: { class: "text-white"}  %>
        <%= c.hidden_field :card_id, value: @card.id %>
        <%= c.submit "Create Collection",
                    class: "inline-flex justify-center py-2 px-4 shadow-sm text-sm font-medium rounded-md text-white bg-gradient-to-r from-blue-500 to-blue-900 hover: from-blue-600 hover:to-blue-700  focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-blue-500" %>
      <% end %>
    </div>
  </div>
<% end %>
