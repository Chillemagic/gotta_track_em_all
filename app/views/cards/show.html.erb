<%# app/views/cards/show.html.erb %>
<div class="card-details">

  <%= render "cards/card_info", card: @card %>


  <button id="simulate-price" data-card-id="<%= @card.id %>">
    Simulate Price Update
  </button>
</div>

<script>
  // Event delegation: works even after Turbo replaces #card-details
  document.addEventListener("click", (event) => {
    const btn = event.target.closest("#simulate-price");
    if (!btn) return;

    fetch(`/cards/${btn.dataset.cardId}/simulate_price`, {
      method: "POST",
      headers: {
        "X-CSRF-Token": document.querySelector('meta[name="csrf-token"]').content,
        "Accept": "application/json"
      }
    })
    .then(response => {
      if (!response.ok) throw new Error("Network response was not ok");
      return response.json();
    })
    .then(data => {
      console.log("Simulated price updated:", data);
    })
    .catch(error => console.error("Error:", error));
  });
</script>
