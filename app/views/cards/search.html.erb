<%# pokemon type,card number, card set,  %>

<%# app/views/cards/search.html.erb %>
<div class="min-h-screen py-12 px-4 sm:px-6 lg:px-8">
  <div class="mx-auto max-w-2xl">

    <!-- Header Section -->
    <div class="text-center mb-8">
      <h1 class="text-5xl font-pokemon text-yellow-400 drop-shadow-[2px_2px_0px_#3B4CCA]">
        Find Your Card
      </h1>
      <p class="mt-5 text-lg font-saira text-gray-200 leading-relaxed">
        Upload an image to search for Pokémon cards
      </p>
    </div>

    <!-- Search Form Card -->
    <div class="bg-white/10 backdrop-blur rounded-2xl p-8 ring-1 ring-white/5 shadow-2xl">
      <%= simple_form_for :search,
                          url: search_cards_path,
                          method: :post,
                          html: {
                            multipart: true,
                            class: "space-y-6",
                            data: { turbo: false }
                          } do |f| %>

              <!-- File Upload Area -->
              <div class="space-y-3">
                <label class="block text-lg font-semibold text-white">
                  Upload Card Image
                </label>

                <div class="relative">
                  <%= f.input :image,
                      as: :file,
                      label: false,
                      input_html: {
                        accept: 'image/*',
                        class: 'block w-full text-sm text-gray-200
                              file:mr-4 file:py-3 file:px-6
                              file:rounded-lg file:border-0
                              file:text-sm file:font-semibold
                              file:bg-gradient-to-r file:from-blue-500 file:to-blue-600
                              file:text-white
                              hover:file:from-blue-600 hover:file:to-blue-700
                              file:cursor-pointer file:transition-all file:duration-200
                              cursor-pointer
                              bg-white/5 rounded-lg p-3
                              border-2 border-dashed border-white/20
                              hover:border-white/40 transition-colors'
                      } %>
          </div>

          <p class="text-sm text-gray-400 flex items-center gap-2">
            <svg class="w-4 h-4" viewBox="0 0 20 20" fill="currentColor" xmlns="http://www.w3.org/2000/svg">
              <path fill-rule="evenodd" d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-7-4a1 1 0 11-2 0 1 1 0 012 0zM9 9a1 1 0 000 2v3a1 1 0 001 1h1a1 1 0 100-2v-3a1 1 0 00-1-1H9z" clip-rule="evenodd" />
            </svg>
            Accepted formats: JPG, PNG, WEBP
          </p>
        </div>

        <!-- Submit Button -->
        <div class="pt-4">
          <%= f.button :submit, "Search Card",
              class: 'w-full relative block min-w-[40px] text-lg px-6 h-14 overflow-hidden group cursor-pointer' do %>
            <!-- Blue background as border -->
            <div class="absolute inset-0 flex flex-col transition duration-100 ease-in-out group-hover:brightness-110">
              <div class="flex-1 bg-blue-500 rounded-t-md"></div>
              <div class="flex-1 bg-blue-800 rounded-b-md"></div>
            </div>

            <!-- Red as button -->
            <div class="absolute inset-[4px] flex flex-col transition duration-100 ease-in-out group-hover:brightness-110">
              <div class="flex-1 bg-red-600"></div>
              <div class="flex-1 bg-red-800"></div>
            </div>

            <!-- Button text -->
            <div class="absolute inset-[6px] flex items-center justify-center gap-2">
              <svg class="w-5 h-5 text-white" viewBox="0 0 20 20" fill="currentColor" xmlns="http://www.w3.org/2000/svg">
                <path fill-rule="evenodd" d="M8 4a4 4 0 100 8 4 4 0 000-8zM2 8a6 6 0 1110.89 3.476l4.817 4.817a1 1 0 01-1.414 1.414l-4.816-4.816A6 6 0 012 8z" clip-rule="evenodd" />
              </svg>
              <span class="text-white text-lg font-bold uppercase tracking-tight">
                Search Card
              </span>
            </div>
          <% end %>
        </div>
      <% end %>

      <!-- Tips Section -->
      <div class="mt-8 pt-8 border-t border-white/10">
        <h3 class="text-sm font-semibold text-white mb-3">📸 Tips for best results:</h3>
        <ul class="space-y-2 text-sm text-gray-300">
          <li class="flex items-start gap-2">
            <span class="text-yellow-400 mt-0.5">★</span>
            <span>Use clear, well-lit photos of your card</span>
          </li>
          <li class="flex items-start gap-2">
            <span class="text-yellow-400 mt-0.5">★</span>
            <span>Ensure the card is centered in the image</span>
          </li>
          <li class="flex items-start gap-2">
            <span class="text-yellow-400 mt-0.5">★</span>
            <span>Avoid reflections or glare on the card surface</span>
          </li>
        </ul>
      </div>
    </div>

  </div>
</div>
