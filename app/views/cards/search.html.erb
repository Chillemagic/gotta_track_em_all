<%# app/views/cards/search.html.erb %>
<div class="min-h-screen py-12 px-4 sm:px-6 lg:px-8">
  <div class="mx-auto max-w-2xl">

    <!-- Header Section -->
    <div class="text-center mb-8">
      <h1 class="sm:text-2xl md:text-10xl lg:text-5xl font-pokemon text-yellow-400 drop-shadow-[2px_2px_0px_#3B4CCA]">
        Find Your Card
      </h1>
      <p class="mt-5 text-lg font-saira text-gray-200 leading-relaxed">
        Upload an image to search for Pokémon cards
      </p>
    </div>

    <%# Search Form Card %>
    <div class="bg-white/10 backdrop-blur rounded-2xl p-8 ring-1 ring-white/5 shadow-2xl">
      <%= simple_form_for :search,
                          url: search_cards_path,
                          method: :post,
                          html: {
                            multipart: true,
                            class: "space-y-6",
                            data: { turbo: false }
                          } do |f| %>

              <%# File Upload Area %>
              <div class="space-y-3">
                <label class="block text-lg font-semibold text-white">
                  Upload Card Image
                </label>

                <div class="relative">
                  <%= f.input :image,
                      as: :file,
                      label: false,
                      input_html: {
                        accept: 'image/*',
                        class: 'block w-full text-sm text-white
                              file:mr-4 file:py-3 file:px-6
                              file:rounded-lg file:border-0
                              file:text-sm file:font-semibold
                              file:bg-gradient-to-r file:from-red-500 file:to-red-900
                              file:text-white
                              hover:file:from-red-600 hover:file:to-red-700
                              file:cursor-pointer file:transition-all file:duration-200
                              cursor-pointer
                              bg-white/5 rounded-lg p-3
                              border-2 border-dashed border-white/20
                              hover:border-white/40 transition-colors'
                      } %>
          </div>

          <p class="text-sm text-gray-400 flex items-center gap-2">
            <svg class="w-4 h-4" viewBox="0 0 20 20" fill="currentColor" xmlns="http://www.w3.org/2000/svg">
              <path fill-rule="evenodd" d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-7-4a1 1 0 11-2 0 1 1 0 012 0zM9 9a1 1 0 000 2v3a1 1 0 001 1h1a1 1 0 100-2v-3a1 1 0 00-1-1H9z" clip-rule="evenodd" />
            </svg>
            Accepted formats: JPG, PNG, WEBP
          </p>
        </div>
        <%# Holo Type Options %>
        <div>
          <%= f.input :holo_type,
                      as: :select,
                      collection: @holo_options,
                      prompt: "Select Holo Type",
                      label_html: { class: "block text-sm font-medium text-white" },
                      input_html: { class: "w-full rounded-md border-gray-300 py-1.5 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 sm:text-sm" } %>
        </div>

        <%# Submit Button %>
        <div class="pt-4">
          <%= render "components/button", button_label: "Search Card", width: "w-full" %>
        </div>
      <% end %>

      <%# Tips Section %>
      <div class="mt-8 pt-8 border-t border-white/10">
        <div class="flex items-center mb-6">
          <%= image_tag "camera.png", :class => "w-10 mr-2" %>
          <h3 class="text-sm font-semibold text-white">Tips for best results:</h3>
        </div>
        <div>
          <ul class="space-y-2 text-sm text-gray-300">
            <li class="flex items-start gap-2">
              <%= image_tag "pokeball_no_bg.png", :class => "w-10" %>
              <span>Use clear, well-lit photos of your card</span>
            </li>
            <li class="flex items-start gap-2">
              <%= image_tag "pokeball_no_bg.png", :class => "w-10" %>
              <span>Ensure the card is centered in the image</span>
            </li>
            <li class="flex items-start gap-2">
              <%= image_tag "pokeball_no_bg.png", :class => "w-10" %>
              <span>Avoid reflections or glare on the card surface</span>
            </li>
          </ul>
        </div>
      </div>
    </div>

  </div>
</div>
