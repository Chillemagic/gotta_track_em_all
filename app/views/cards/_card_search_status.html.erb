<div class="text-center mb-8">
  <%# Define statuses for comparison %>
  <% api_tcg = card.api_tcg_status %>
  <% tcg_dex = card.tcg_dex_status %>

  <%# Success %>
  <% if api_tcg == "complete" || tcg_dex == "complete" %>
     <h1 class="text-5xl font-pokemon text-yellow-400 drop-shadow-[2px_2px_0px_#3B4CCA]">
      Match found!
    </h1>

  <%# Pending %>
  <% elsif  api_tcg == "pending" || tcg_dex == "pending"  %>
    <h1 class="text-5xl font-pokemon text-yellow-400 drop-shadow-[2px_2px_0px_#3B4CCA]">
      Searching for a match
    </h1>
    <%# Failure %>
  <% elsif api_tcg == "incomplete" %>
    <h1 class="flex items-center gap-3 text-5xl font-pokemon text-yellow-400 drop-shadow-[2px_2px_0px_#3B4CCA]">
      <span>Sorry we couldn't find more info</span>
      <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="w-12 h-12">
        <path stroke-linecap="round" stroke-linejoin="round" d="M15.182 16.318A4.486 4.486 0 0 0 12.016 15a4.486 4.486 0 0 0-3.198 1.318M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0ZM9.75 9.75c0 .414-.168.75-.375.75S9 10.164 9 9.75 9.168 9 9.375 9s.375.336.375.75Zm-.375 0h.008v.015h-.008V9.75Zm5.625 0c0 .414-.168.75-.375.75s-.375-.336-.375-.75.168-.75.375-.75.375.336.375.75Zm-.375 0h.008v.015h-.008V9.75Z" />
      </svg>
    </h1>
  <% end %>
</div>
