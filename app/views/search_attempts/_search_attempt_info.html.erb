<% searching = search_attempt.status_pending? ||
               search_attempt.status_identifying? ||
               search_attempt.status_creating_card? %>
<% card = search_attempt.card %>
<% latest_price = card&.price_histories&.order(created_at: :desc)&.first %>

<div id="<%= dom_id(search_attempt) %>">
  <header class="mb-8 text-center">
    <p class="mb-3 text-sm font-bold uppercase tracking-[0.25em] text-blue-200">
      Card identification
    </p>

    <h1 class="font-pokemon text-3xl text-yellow-400 drop-shadow-[2px_2px_0px_#3B4CCA] sm:text-4xl lg:text-5xl">
      <% if search_attempt.status_matched? %>
        Match found!
      <% elsif search_attempt.status_failed? %>
        No match found
      <% else %>
        Searching for a match
      <% end %>
    </h1>

    <p class="mx-auto mt-5 max-w-2xl text-base leading-relaxed text-gray-200 sm:text-lg">
      <% if search_attempt.status_matched? %>
        Review the match and add it to one of your collections.
      <% elsif search_attempt.status_failed? %>
        We could not confidently identify this card using the initial search.
      <% else %>
        We are comparing your photo with our card catalogue. This may take a moment.
      <% end %>
    </p>
  </header>

  <% if searching %>
    <section class="rounded-2xl bg-white/10 p-8 text-center shadow-2xl ring-1 ring-white/10 backdrop-blur">
      <%= image_tag "pokeball_no_bg.png", alt: "Searching", class: "mx-auto mb-6 w-20 animate-spin" %>

      <h2 class="text-2xl font-semibold text-white">
        <% if search_attempt.status_creating_card? %>
          Preparing your card details…
        <% else %>
          Analysing your card…
        <% end %>
      </h2>

      <p class="mt-3 text-gray-300">
        This page will update automatically when the search finishes.
      </p>
    </section>
  <% else %>
    <div class="grid grid-cols-1 gap-8 lg:grid-cols-2">
      <section class="rounded-2xl bg-white/10 p-6 shadow-2xl ring-1 ring-white/10 backdrop-blur">
        <h2 class="mb-5 text-center text-xl font-semibold text-white">
          <%= card.present? ? "Matched card" : "Your uploaded photo" %>
        </h2>

        <% if card&.image_url.present? %>
          <%= image_tag card.image_url,
            alt: card.name,
            class: "mx-auto max-h-[34rem] w-full rounded-xl object-contain shadow-xl" %>
        <% elsif search_attempt.image.attached? %>
          <%= image_tag search_attempt.image,
            alt: "Uploaded Pokémon card",
            class: "mx-auto max-h-[34rem] w-full rounded-xl object-contain shadow-xl" %>
        <% else %>
          <div class="flex min-h-72 items-center justify-center rounded-xl border-2 border-dashed border-white/20 bg-black/20 px-6 text-center text-gray-300">
            The uploaded image is no longer available.
          </div>
        <% end %>
      </section>

      <section class="rounded-2xl border border-white/20 bg-white/10 p-6 shadow-2xl ring-1 ring-white/5 backdrop-blur">
        <% if search_attempt.status_matched? && card.present? %>
          <p class="text-sm font-bold uppercase tracking-wider text-blue-200">Identified card</p>
          <h2 class="mt-2 text-3xl font-bold text-white"><%= card.name %></h2>

          <dl class="mt-6 space-y-4 text-gray-200">
            <div class="flex justify-between gap-4 border-b border-white/10 pb-3">
              <dt class="font-semibold text-white">Set</dt>
              <dd class="text-right"><%= card.set_name.presence || "Unknown" %></dd>
            </div>
            <div class="flex justify-between gap-4 border-b border-white/10 pb-3">
              <dt class="font-semibold text-white">Number</dt>
              <dd class="text-right"><%= card.card_number.presence || "Unknown" %></dd>
            </div>
            <div class="flex justify-between gap-4 border-b border-white/10 pb-3">
              <dt class="font-semibold text-white">Rarity</dt>
              <dd class="text-right"><%= card.rarity.presence || "Unknown" %></dd>
            </div>
            <div class="flex justify-between gap-4 pb-3">
              <dt class="font-semibold text-white">Search provider</dt>
              <dd class="text-right capitalize"><%= search_attempt.provider %></dd>
            </div>
          </dl>

          <div class="mt-6 border-t border-white/10 pt-6">
            <h3 class="text-lg font-semibold text-white">Latest prices</h3>

            <% if latest_price.present? %>
              <p class="mt-1 text-xs text-gray-400">
                <%= latest_price.recorded_at || latest_price.created_at.to_date %>
                <% if latest_price.source.present? %>
                  · <%= latest_price.source %>
                <% end %>
              </p>

              <% if latest_price.pokedata_raw_price.present? %>
                <div class="mt-4 rounded-lg bg-black/20 p-4 ring-1 ring-white/10">
                  <p class="text-sm text-gray-300">Raw market value</p>
                  <p class="mt-1 text-3xl font-bold text-white">
                    <%= number_to_currency(latest_price.pokedata_raw_price) %>
                  </p>
                </div>
              <% end %>

              <% available_prices = latest_price.pricing_data.to_h.select { |_label, details| details.is_a?(Hash) && details["value"].present? } %>

              <% if available_prices.any? %>
                <ul class="mt-4 max-h-48 divide-y divide-white/10 overflow-y-auto pr-1 text-sm">
                  <% available_prices.each do |label, details| %>
                    <li class="flex justify-between gap-4 py-2">
                      <span class="text-gray-300"><%= label %></span>
                      <span class="font-semibold text-white"><%= number_to_currency(details["value"]) %></span>
                    </li>
                  <% end %>
                </ul>
              <% end %>
            <% else %>
              <p class="mt-2 text-sm text-gray-300">
                Pricing is not available for this card yet.
              </p>
            <% end %>
          </div>

          <div class="mt-6 border-t border-white/10 pt-6">
            <% collections = search_attempt.user.collections.order(:name) %>

            <% if collections.exists? %>
              <% pricing_keys = latest_price&.pricing_data.to_h.keys %>
              <% grading_keys = pricing_keys.grep(/\A(?:PSA|CGC)\s*\d+(?:\.\d+)?\z/) %>
              <% raw_keys = pricing_keys.select { |key| key.to_s.downcase.include?("raw") } %>
              <% condition_options = ([ "Raw" ] + raw_keys + grading_keys).uniq %>

              <%= simple_form_for CollectionCard.new, url: collection_cards_path, data: { turbo_frame: "_top" } do |form| %>
                <%= hidden_field_tag :search_attempt_id, search_attempt.id %>
                <%= form.hidden_field :card_id, value: card.id %>

                <%= form.input :collection_id,
                  collection: collections.pluck(:name, :id),
                  prompt: "Select a collection",
                  label_html: { class: "block text-sm font-medium text-white" },
                  input_html: {
                    required: true,
                    class: "w-full rounded-md border-gray-300 py-1.5 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 sm:text-sm"
                  } %>

                <%= form.input :condition,
                  as: :select,
                  collection: condition_options.map { |condition| [ collection_card_condition_label(condition), condition ] },
                  selected: "Raw",
                  prompt: "Select a condition",
                  label_html: { class: "text-white" },
                  input_html: { class: "w-full rounded-md border-gray-300 py-1.5 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 sm:text-sm" } %>

                <%= form.input :description,
                  as: :text,
                  label_html: { class: "text-white" },
                  input_html: { rows: 2, class: "w-full rounded-md border-gray-300 py-1.5 shadow-sm focus:border-indigo-500 focus:ring-indigo-500 sm:text-sm" } %>

                <div class="mt-4">
                  <%= form.submit "Add to Collection",
                    class: "inline-flex justify-center py-2 px-4 shadow-sm text-sm font-medium rounded-md text-white bg-gradient-to-r from-red-500 to-red-900 hover:from-red-600 hover:to-red-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-indigo-500",
                    data: { turbo_submits_with: "Adding card…" } %>
                </div>
              <% end %>
            <% else %>
              <p class="text-sm text-gray-300">Create a collection before adding this card.</p>
              <%= link_to "Create a collection",
                new_collection_path,
                class: "mt-4 inline-flex w-full justify-center rounded-lg bg-gradient-to-r from-red-500 to-red-800 px-5 py-3 font-bold uppercase tracking-tight text-white ring-4 ring-blue-700 transition hover:brightness-110" %>
            <% end %>
          </div>
        <% else %>
          <p class="text-sm font-bold uppercase tracking-wider text-red-200">Search unsuccessful</p>
          <h2 class="mt-2 text-2xl font-semibold text-white">We need another look</h2>

          <p class="mt-4 text-gray-300">
            <%= search_attempt.error_message.presence || "The first search did not return a reliable match." %>
          </p>
        <% end %>

        <% if search_attempt.image.attached? %>
          <div class="mt-8 border-t border-white/10 pt-5 text-center">
            <% if search_attempt.scrydex_requested_at.nil? %>
              <p class="text-xs text-gray-400">Not the right card?</p>
              <%= button_to "Try a more accurate image search",
                retry_with_scrydex_search_attempt_path(search_attempt),
                method: :post,
                class: "mt-2 text-sm font-semibold text-blue-200 underline decoration-blue-300/30 underline-offset-4 transition hover:text-yellow-400",
                data: { turbo_submits_with: "Starting image search…" } %>
            <% else %>
              <p class="text-xs text-gray-400">
                The more accurate image search has already been requested.
              </p>
            <% end %>
          </div>
        <% end %>
      </section>
    </div>
  <% end %>

  <div class="mt-8 text-center">
    <%= link_to "Search another card",
      search_cards_path,
      class: "text-sm font-semibold text-gray-200 underline decoration-white/30 underline-offset-4 transition hover:text-yellow-400" %>
  </div>
</div>
