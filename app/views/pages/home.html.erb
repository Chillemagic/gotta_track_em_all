<main class="isolate relative flex flex-1 flex-col overflow-hidden">
  <!-- Hero section -->
  <div class="w-full flex-1 pb-4">

  <%# ----------------------- Corousel section ----------------------------------------------- %>
  <section
    id="collection-insights-carousel"
    class="mx-auto my-6 w-full max-w-5xl px-4 sm:my-12 sm:px-6 lg:px-8"
    aria-label="Collection insights"
    data-controller="carousel"
    data-carousel-dots-value="true"
    data-carousel-buttons-value="true"
    data-carousel-loop-value="true"
  >
    <div
      class="
        cursor-grab overflow-hidden rounded-3xl outline-hidden focus-visible:ring-2 focus-visible:ring-emerald-700 focus-visible:ring-offset-2 active:cursor-grabbing
      "
      data-carousel-target="viewport"
    >
      <div class="flex touch-pan-y items-stretch">
        <% [
          { title: "Snap", image: "camera.png", alt: "Camera illustration", headline: "Identify cards in an instant.", description: "Take a photo or upload an image from your device. Our AI-powered scanner identifies the card for you.", features: ["Snap a photo", "Upload an image", "Find your card"] },
          { title: "Discover", image: "dex.png", alt: "Pokédex illustration", headline: "Get to know every card.", description: "Explore the details behind your latest find, with card information and pricing in one place.", features: ["Set and release details", "Card artist", "Attacks and abilities", "Pricing data"] },
          { title: "Collect", image: "collect.png", alt: "Card collection illustration", headline: "Your collection, your way.", description: "Keep your cards organized in custom collections that reflect how you like to collect.", features: ["Type", "Colour", "Set", "Personal themes and categories"] }
        ].each_with_index do |slide, index| %>
          <article
            class="mr-4 flex min-w-0 flex-[0_0_100%] select-none flex-col items-center gap-6 rounded-3xl border border-white/60 bg-slate-100/70 p-2 text-slate-900 backdrop-blur sm:p-8 md:flex-row md:gap-10 md:p-10 "
            aria-label="<%= index + 1 %> of 3: <%= slide[:title] %>"
            aria-roledescription="slide"
          >
            <div class="flex w-full shrink-0 items-center justify-center rounded-2xl p-4 md:w-2/5 md:p-6">
              <%= image_tag slide[:image], alt: slide[:alt], draggable: false,
                class: "h-[clamp(10rem,35vw,20rem)] w-full object-contain", decoding: "async" %>
            </div>
            <div class="min-w-0 flex-1 text-center md:text-left">
              <p class="text-sm font-bold uppercase tracking-[0.2em] text-emerald-800"><%= slide[:title] %></p>
              <h2 class="mt-3 text-[clamp(1.5rem,3vw,2.5rem)] font-bold leading-tight tracking-tight text-balance"><%= slide[:headline] %></h2>
              <p class="mx-auto mt-4 max-w-prose text-base leading-relaxed text-slate-700 sm:text-lg md:mx-0"><%= slide[:description] %></p>
              <ul class="mt-5 flex flex-wrap justify-center gap-2 md:justify-start">
                <% slide[:features].each do |feature| %>
                  <li class="rounded-full bg-emerald-50/70 px-3 py-1.5 text-sm font-medium leading-snug text-emerald-900 ring-1 ring-inset ring-emerald-800/15"><%= feature %></li>
                <% end %>
              </ul>
            </div>
          </article>
        <% end %>
      </div>
    </div>

    <div class="mt-4 flex items-center justify-between px-1">
      <div class="grid grid-cols-2 gap-2">
        <button
          class="
            flex size-11 items-center justify-center rounded-full border border-white/60
            bg-slate-100/70 text-emerald-900 shadow-sm backdrop-blur transition hover:bg-emerald-50/70
            focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-emerald-700
            disabled:cursor-not-allowed disabled:opacity-40
          "
          type="button"
          data-carousel-target="prevButton"
          aria-label="Previous insight"
        >
          <svg aria-hidden="true" class="size-4" viewBox="0 0 18 18" fill="currentColor"><path
              d="M11.5 16a.75.75 0 0 1-.53-.22L4.72 9.53a.75.75 0 0 1 0-1.06l6.25-6.25a.75.75 0 1 1 1.06 1.06L6.31 9l5.72 5.72A.75.75 0 0 1 11.5 16Z"
            /></svg>
        </button>
        <button
          class="
            flex size-11 items-center justify-center rounded-full border border-white/60
            bg-slate-100/70 text-emerald-900 shadow-sm backdrop-blur transition hover:bg-emerald-50/70
            focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-emerald-700
            disabled:cursor-not-allowed disabled:opacity-40
          "
          type="button"
          data-carousel-target="nextButton"
          aria-label="Next insight"
        >
          <svg aria-hidden="true" class="size-4" viewBox="0 0 18 18" fill="currentColor"><path
              d="M6.5 16a.75.75 0 0 1-.53-1.28L11.69 9 5.97 3.28a.75.75 0 0 1 1.06-1.06l6.25 6.25a.75.75 0 0 1 0 1.06l-6.25 6.25A.75.75 0 0 1 6.5 16Z"
            /></svg>
        </button>
      </div>
      <div
        class="flex flex-wrap items-center justify-end gap-1.5"
        data-carousel-target="dotsContainer"
      ></div>
    </div>
  </section>

  <%# ---------------- Button Section --------------------- %>
  <div>
    <div data-controller="dialog" data-action="click->dialog#backdropClose" class="w-full flex"> 
      <dialog data-dialog-target="dialog" class="mx-auto my-auto p-12 rounded-xl bg-slate-100/70 backdrop:bg-black/80">
        <h2 class="text-center p-2 text-slate-700">
          New Users:
        </h2>
        <div class ="m-2">
          <%= render "components/button", button_label: "Create Account", button_path: new_user_registration_path%>
        </div>
        <hr class="border-slate-100/70">
        <h2 class="text-center p-2 text-slate-700">
          Existing Users:
        </h2>
        <div class="m-2">
          <%= render "components/button", button_label: "User Login", button_path: new_user_session_path  %>
        </div>
      </dialog>
      <%= render "components/button",
          button_label: "Get Started",
          margin: "mx-auto",
          button_path: "#",
          action: "click->dialog#open:prevent" 
      %>
    </div>

  </div>

  </div>

  <%# ----------------- Marquee Section -------------------------- %>
  <footer class="shrink-0 bg-gray-400/30 backdrop-blur pb-[env(safe-area-inset-bottom,0px)]">
    <div class="w-full">
