<main class="isolate relative overflow-hidden">
  <!-- Hero section -->
  <div class="relative pt-0">

    <!-- Hero Text -->
    <div class="py-1 sm:py-8 lg:pb-24">
      <div class="mx-auto max-w-7xl px-6 lg:px-8 ">
        <div class="mx-auto max-w-2xl text-center z-10 relative">
          <h1 class="font-pokemon tracking-tight text-gray-900 sm:text-4xl lg:text-5xl">
            Hello there,
          </h1>
          <h1 class="font-pokemon tracking-tight text-gray-900 sm:text-4xl lg:text-5xl">
            <%= current_user&.username.presence || "Trainer" %>!
          </h1>
        </div>

        <div class="mt-0 h-115 flow-root sm:mt-24 z-10 relative">
          <% if current_user&.pokescientist? %>
            <div class="mt-auto mx-auto max-w-3/4 bg-white bg-white/10 backdrop-blur rounded-2xl p-8 ring-1 ring-white/5 shadow-2xl">
              <div class="h-115 w-full flex items-center justify-center text-gray-500 text-sm italic">
                <%= render "pokescientist_home" %>
              </div>
            </div>
          <% elsif current_user&.pokemaniac? %>
            <div class="mt-auto mx-auto max-w-3/4 bg-white bg-white/10 backdrop-blur rounded-2xl p-8 ring-1 ring-white/5 shadow-2xl">
              <div class="h-115 w-full flex items-center justify-center text-gray-500 text-sm italic">
                <%= render "pokemaniac_home" %>
              </div>
            </div>
          <% end %>
        </div>
      </div>
    </div>
  </div>
</main>
