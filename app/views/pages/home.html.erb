<main class="isolate relative overflow-hidden">
  <!-- Hero section -->
  <div class="relative pt-0">

    <!-- Top Gradient Background -->
    <div aria-hidden="true" class="absolute inset-x-0 -top-40 -z-10 transform-gpu overflow-hidden blur-3xl sm:-top-80">
      <div style="clip-path: polygon(74.1% 44.1%, 100% 61.6%, 97.5% 26.9%, 85.5% 0.1%, 80.7% 2%, 72.5% 32.5%, 60.2% 62.4%, 52.4% 68.1%, 47.5% 58.3%, 45.2% 34.5%, 27.5% 76.7%, 0.1% 64.9%, 17.9% 100%, 27.6% 76.8%, 76.1% 97.7%, 74.1% 44.1%)"
           class="relative left-[calc(50%-11rem)] aspect-[1155/678] w-[144.5rem] -translate-x-1/2 rotate-30 bg-gradient-to-tr from-[#ff80b5] to-[#9089fc] opacity-30 sm:left-[calc(50%-30rem)] sm:w-[288.75rem]">
      </div>
    </div>

    <!-- Hero Text -->
    <div class="py-1 sm:py-8 lg:pb-24">
      <div class="mx-auto max-w-7xl px-6 lg:px-8 ">
        <div class="mx-auto max-w-2xl text-center z-10 relative">
          <h1 class="font-pokemon tracking-tight text-gray-900 sm:text-4xl lg:text-5xl">
            Hello there,
          </h1>
          <h1 class="font-pokemon tracking-tight text-gray-900 sm:text-4xl lg:text-5xl">
            <%= current_user&.username.presence || "Trainer" %>!
          </h1>
        </div>

        <div class="mt-0 h-115 flow-root sm:mt-24 z-10 relative">
          <% if current_user&.pokescientist? %>
            <div class="mt-auto mx-auto max-w-3/4 bg-white bg-white/10 backdrop-blur rounded-2xl p-8 ring-1 ring-white/5 shadow-2xl">
              <div class="h-115 w-full flex items-center justify-center text-gray-500 text-sm italic">
                <%= render "pokescientist_home" %>
              </div>
            </div>
          <% elsif current_user&.pokemaniac? %>
            <div class="mt-auto mx-auto max-w-3/4 bg-white bg-white/10 backdrop-blur rounded-2xl p-8 ring-1 ring-white/5 shadow-2xl">
              <div class="h-115 w-full flex items-center justify-center text-gray-500 text-sm italic">
                <%= render "pokemaniac_home" %>
              </div>
            </div>
          <% end %>
        </div>
      </div>
    </div>

    <!-- Bottom Gradient Background -->
    <div class="mt-8 flex flex-row items-center justify-center gap-5">
      <div aria-hidden="true" class="absolute inset-x-0 top-[calc(100%-13rem)] -z-10 transform-gpu overflow-hidden sm:top-[calc(100%-30rem)]">
        <div style="clip-path: polygon(74.1% 44.1%, 100% 61.6%, 97.5% 26.9%, 85.5% 0.1%, 80.7% 2%, 72.5% 32.5%, 60.2% 62.4%, 52.4% 68.1%, 47.5% 58.3%, 45.2% 34.5%, 27.5% 76.7%, 0.1% 64.9%, 17.9% 100%, 27.6% 76.8%, 76.1% 97.7%, 74.1% 44.1%)"
             class="relative left-[calc(50%+3rem)] aspect-[1155/678] w-[144.5rem] -translate-x-1/2 bg-gradient-to-tr from-[#ff80b5] to-[#9089fc] opacity-30 sm:left-[calc(50%+36rem)] sm:w-[288.75rem]">
        </div>
      </div>
    </div>
  </div>
</main>
