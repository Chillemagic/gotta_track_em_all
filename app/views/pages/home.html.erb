<main class="isolate relative">
  <!-- Hero section -->
  <div class="relative pt-10">

    <!-- Hero Text -->
    <div class="py-1 sm:py-8 lg:pb-24">
      <div class="mx-auto max-w-7xl px-6 lg:px-8">
        <div class="mx-auto max-w-2xl text-center z-10 relative">
          <h1 class="font-pokemon tracking-tight text-gray-900 sm:text-4xl lg:text-5xl">
            Hello there,
          </h1>
          <h1 class="font-pokemon tracking-tight text-gray-900 sm:text-4xl lg:text-5xl">
            <%= current_user&.username.presence || "Trainer" %>!
          </h1>
        </div>

        <div class="mt-8 flow-root sm:mt-24 z-10 relative">
          <% if current_user&.pokescientist? %>
            <div class="mt-auto mx-auto max-w-md bg-white rounded-lg shadow-md p-4">
              <div class="h-64 bg-gray-100 flex items-center justify-center text-gray-500 text-sm italic">
                <%= render "pokescientist_home" %>
              </div>
            </div>
          <% elsif current_user&.pokemaniac? %>
            <div class="mt-auto mx-auto max-w-md bg-white rounded-lg shadow-md p-4">
              <div class="h-64 bg-gray-100 flex items-center justify-center text-gray-500 text-sm italic">
                PokeFolio splash goes here
              </div>
            </div>
          <% end %>
        </div>
      </div>
    </div>
  </div>
</main>
