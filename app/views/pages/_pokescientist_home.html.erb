<% if current_user.collection_cards.empty? %>
  <%= render "empty_collection_home" %>
<% else %>
  <% most_card = current_user.most_valuable_card %>
  <% most_set = current_user.most_valuable_set %>

  <div class="w-full">
    <h2
      class="font-pokemon text-center text-yellow-400 mb-5 md:text-3xl"
      style="text-shadow: 2px 2px 0 #d97706, -1px -1px 0 #d97706, 1px -1px 0 #d97706, -1px 1px 0 #d97706;"
    >
      Collection Insights
    </h2>
    <!-- Static layout for medium viewports and above -->
    <div class="hidden md:block h-[calc(30rem-3.5rem)] rounded-xl">
      <div class="flex h-full w-full items-stretch gap-4">
        <div class="flex flex-[3] flex-col gap-3">
          <div
            class="
              flex flex-1 flex-col justify-center rounded-xl border border-white/20
              bg-white/10 p-3 shadow-lg backdrop-blur
            "
          >
            <p class="text-xs font-bold uppercase tracking-wider text-gray-700">Total card value</p>
            <p class="text-3xl font-bold text-gray-900"><%= number_to_currency(current_user.total_card_value, precision: 2) %></p>
          </div>
          <div
            class="
              flex flex-1 flex-col justify-center rounded-xl border border-white/20
              bg-white/10 p-3 shadow-lg backdrop-blur
            "
          >
            <p class="text-xs font-bold uppercase tracking-wider text-gray-700">Average price</p>
            <p class="text-3xl font-bold text-gray-900"><%= number_to_currency(current_user.average_card_price, precision: 2) %></p>
          </div>
          <% if most_set&.dig(:set_name) %>
            <div
              class="
                flex flex-1 flex-col justify-center rounded-xl border border-white/20
                bg-white/10 p-3 shadow-lg backdrop-blur
              "
            >
              <p class="text-xs font-bold uppercase tracking-wider text-gray-700">Top set</p>
              <p class="truncate text-base font-bold italic text-gray-900"><%= most_set[:set_name] %></p>
              <p class="mt-1 text-2xl font-bold text-gray-900"><%= number_to_currency(most_set[:total], precision: 2) %></p>
            </div>
          <% end %>
        </div>

        <% if most_card %>
          <div
            class="
              flex flex-[2] flex-col rounded-xl border border-white/20 bg-white/10 p-3
              shadow-lg backdrop-blur
            "
          >
            <p
              class="
                mb-2 text-center text-xs font-bold uppercase tracking-wider text-gray-700
              "
            >Most valuable card</p>
            <p class="mb-2 text-center text-lg font-bold italic text-gray-900"><%= most_card.card.name %></p>
            <%= link_to collection_card_path(most_card),
            class: "relative mb-3 block min-h-0 flex-1 rounded-lg",
            aria: { label: "View #{most_card.card.name}" } do %>
              <div
                class="absolute inset-0 h-full w-full rounded-lg"
                style="--front: url('<%= most_card.card.image_url %>'); background-image: var(--front); background-size: contain; background-position: center; background-repeat: no-repeat;"
                role="img"
                aria-label="<%= most_card.card.name %>"
              ></div>
            <% end %>
            <div class="text-center">
              <p class="text-xs font-bold uppercase tracking-wider text-gray-700">Current price</p>
              <p class="text-2xl font-bold text-gray-900"><%= number_to_currency(most_card.fetch_price, precision: 2) %></p>
            </div>
          </div>
        <% end %>
      </div>
    </div>
    <!-- Two-card carousel for small viewports -->
    <section
      id="collection-insights-carousel"
      class="mx-auto w-full max-w-md overflow-hidden md:hidden"
      aria-label="Collection insights"
      data-controller="carousel"
      data-carousel-dots-value="true"
      data-carousel-buttons-value="true"
      data-carousel-loop-value="false"
    >
      <div
        class="
          cursor-grab overflow-hidden outline-hidden active:cursor-grabbing
        "
        data-carousel-target="viewport"
      >
        <div class="flex">
          <article
            class="
              mr-3 flex min-w-0 basis-full flex-shrink-0 flex-grow-0 select-none flex-col
              rounded-2xl border border-white/20 bg-white/10 p-5 shadow-lg ring-1 ring-white/5
              backdrop-blur
            "
          >
            <% if most_card %>
              <p class="text-center text-xs font-bold uppercase tracking-wider text-gray-700">Most valuable card</p>
              <p class="mt-1 text-center text-lg font-bold italic text-gray-900"><%= most_card.card.name %></p>
              <%= link_to collection_card_path(most_card), class: "mt-3 flex min-h-0 flex-1 items-center justify-center" do %>
                <%= image_tag most_card.card.image_url,
                alt: most_card.card.name,
                class:
                  "h-48 w-auto max-w-full rounded-lg object-contain shadow-lg transition duration-300 ease-out hover:scale-105 hover:shadow-2xl" %>
              <% end %>
              <div class="mt-3 text-center">
                <p class="text-xs font-bold uppercase tracking-wider text-gray-700">Current price</p>
                <p class="text-2xl font-bold text-gray-900"><%= number_to_currency(most_card.fetch_price, precision: 2) %></p>
              </div>
            <% else %>
              <div
                class="
                  flex min-h-80 items-center justify-center text-center text-sm text-gray-700
                "
              >
                Add a card to see your most valuable card.
              </div>
            <% end %>
          </article>

          <article
            class="
              flex min-w-0 basis-full flex-shrink-0 flex-grow-0 select-none flex-col
              justify-center gap-3 rounded-2xl border border-white/20 bg-white/10 p-5
              shadow-lg ring-1 ring-white/5 backdrop-blur
            "
          >
            <div
              class="
                rounded-xl border border-white/20 bg-white/10 p-4 shadow-md backdrop-blur
              "
            >
              <p class="text-xs font-bold uppercase tracking-wider text-gray-700">Total card value</p>
              <p class="text-3xl font-bold text-gray-900"><%= number_to_currency(current_user.total_card_value, precision: 2) %></p>
            </div>
            <div
              class="
                rounded-xl border border-white/20 bg-white/10 p-4 shadow-md backdrop-blur
              "
            >
              <p class="text-xs font-bold uppercase tracking-wider text-gray-700">Average price</p>
              <p class="text-3xl font-bold text-gray-900"><%= number_to_currency(current_user.average_card_price, precision: 2) %></p>
            </div>
            <% if most_set&.dig(:set_name) %>
              <div
                class="
                  rounded-xl border border-white/20 bg-white/10 p-4 shadow-md backdrop-blur
                "
              >
                <p class="text-xs font-bold uppercase tracking-wider text-gray-700">Top set</p>
                <p class="truncate text-base font-bold italic text-gray-900"><%= most_set[:set_name] %></p>
                <p class="mt-1 text-2xl font-bold text-gray-900"><%= number_to_currency(most_set[:total], precision: 2) %></p>
              </div>
            <% end %>
          </article>
        </div>
      </div>

      <div class="mt-4 flex items-center justify-between px-1">
        <div class="grid grid-cols-2 gap-2">
          <button
            class="
              flex size-10 items-center justify-center rounded-full border border-white/20
              bg-white/20 text-gray-800 shadow-md backdrop-blur transition hover:bg-white/30
              disabled:cursor-not-allowed disabled:opacity-40
            "
            type="button"
            data-carousel-target="prevButton"
            aria-label="Previous insight"
          >
            <svg aria-hidden="true" class="size-4" viewBox="0 0 18 18" fill="currentColor"><path
                d="M11.5 16a.75.75 0 0 1-.53-.22L4.72 9.53a.75.75 0 0 1 0-1.06l6.25-6.25a.75.75 0 1 1 1.06 1.06L6.31 9l5.72 5.72A.75.75 0 0 1 11.5 16Z"
              /></svg>
          </button>
          <button
            class="
              flex size-10 items-center justify-center rounded-full border border-white/20
              bg-white/20 text-gray-800 shadow-md backdrop-blur transition hover:bg-white/30
              disabled:cursor-not-allowed disabled:opacity-40
            "
            type="button"
            data-carousel-target="nextButton"
            aria-label="Next insight"
          >
            <svg aria-hidden="true" class="size-4" viewBox="0 0 18 18" fill="currentColor"><path
                d="M6.5 16a.75.75 0 0 1-.53-1.28L11.69 9 5.97 3.28a.75.75 0 0 1 1.06-1.06l6.25 6.25a.75.75 0 0 1 0 1.06l-6.25 6.25A.75.75 0 0 1 6.5 16Z"
              /></svg>
          </button>
        </div>
        <div
          class="flex flex-wrap items-center justify-end gap-1.5"
          data-carousel-target="dotsContainer"
        ></div>
      </div>
    </section>
  </div>
<% end %>
