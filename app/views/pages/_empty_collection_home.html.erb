<section class="flex h-full w-full flex-col items-center justify-center px-2 py-4 text-center sm:px-6"
         aria-labelledby="empty-collection-heading">
  <h2 id="empty-collection-heading"
      class="font-pokemon text-xl leading-snug text-yellow-400 sm:text-2xl lg:text-3xl"
      style="text-shadow: 2px 2px 0 #d97706, -1px -1px 0 #d97706, 1px -1px 0 #d97706, -1px 1px 0 #d97706;">
    Your collection is ready for its first card!
  </h2>

  <%= link_to search_cards_path,
              class: "group mt-4",
              aria: { label: "Search for your first card" } do %>
    <%= image_tag "c_back.png",
                  alt: "",
                  class: "h-40 w-28 rounded-lg object-contain shadow-lg transition duration-300 ease-out group-hover:scale-105 group-hover:shadow-2xl sm:h-48 sm:w-36",
                  draggable: false %>
  <% end %>

  <p class="mt-3 max-w-md text-sm not-italic text-gray-700 sm:text-base">
    Search for a Pokémon card and add it to your collection to unlock your dashboard.
  </p>

  <div class="mt-4 flex justify-center">
    <%= render "components/button", button_label: "Search Cards",
               width: "w-48 md:w-64", button_path: search_cards_path %>
  </div>
</section>
